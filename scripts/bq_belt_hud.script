-- ============================================================================
-- ПАНЕЛЬ ПОЯСА АРТЕФАКТОВ НА HUD (идея заказчика, 10.10.2026).
--
-- Рисует внизу экрана, правее слотов быстрого доступа, иконки предметов пояса:
-- сначала артефакты по порядку ячеек, потом аккумулятор. ПУСТЫЕ ЯЧЕЙКИ НЕ
-- РИСУЮТСЯ (заказчик: "арт1, арт2, аккумулятор" и никаких пропусков).
-- Аккумулятор не подкрашивается, вместо этого под ним выводится ЧИСЛО - процент
-- заряда.
--
-- КАК РИСУЕТСЯ. Через get_hud():AddCustomStatic(имя, true) - это штатный способ
-- добавить свои элементы на HUD из Lua (CUIGameCustom::AddCustomStatic,
-- UIGameCustom.cpp:152, отдан в Lua в UIGameCustom_script.cpp:29-33). Статиков
-- ровно MAX: столько же, сколько ячеек может быть занято (5 артефактов + 1
-- аккумулятор), лишние просто скрываются.
--
-- ОТКУДА БЕРЁТСЯ КАРТИНКА. Из конфига секции предмета: icons_texture (атлас) и
-- inv_grid_x/y/width/height (ячейка в сетке 50x50), то есть то же, чем движок
-- рисует предмет в инвентаре. Размер на HUD - как ячейка пояса в инвентаре
-- (ICON_W x ICON_H), как просил заказчик.
--
-- ПОЛОЖЕНИЕ. BASE_X/BASE_Y - в единицах интерфейса (база 1024x768). Слоты
-- быстрого доступа в ixray-hd-hud\configs\ui\maingame_16.xml стоят на x=16, 56,
-- 96, 136 при y=705 (шаг 40, размер 20x25), поэтому панель начинается правее -
-- с x=190. Если надо подвинуть, правится в [bq_battery_hud] (hud_x, hud_y).
-- ============================================================================

local MAX_ICONS = 6
local ICON_W, ICON_H = 33, 41     -- ячейка пояса в инвентаре
local ICON_GAP = 4
local CELL = 50                   -- шаг сетки иконок в атласах
local HUD_SECTION = "bq_battery_hud"

local statics = {}                -- i -> CUIStatic (иконка)
local labels = {}                 -- i -> CUIStatic (число заряда)
local icon_cache = {}             -- секция -> {tex=, x=, y=, w=, h=} или false
local cfg_errors = {}
local hud_warned = false

local function dbg(msg)
    local f = io.open("bq_battery.log", "a")
    if f then f:write(string.format("%s  %s\n", os.date("%H:%M:%S"), msg)); f:close() end
end

local function cfg_value(section, key, default, is_string)
    local ok, value = pcall(function()
        local ini = system_ini()
        if not ini:section_exist(section) then return nil end
        if not ini:line_exist(section, key) then return nil end
        if is_string then return ini:r_string(section, key) end
        return ini:r_float(section, key)
    end)
    if ok and value ~= nil then return value end
    local tag = section .. "." .. key
    if not cfg_errors[tag] then
        cfg_errors[tag] = true
        dbg("HUD: не смог прочитать " .. tag .. ", беру значение по умолчанию")
    end
    return default
end

-- get_hud() может быть недоступен (например, до загрузки уровня) - молча выходим.
local function game_hud()
    local ok, h = pcall(function() return get_hud() end)
    if ok and h then return h end
    if not hud_warned then
        hud_warned = true
        dbg("HUD: get_hud() недоступен, панель пояса не рисуется")
    end
    return nil
end

-- Ячейка иконки предмета из его секции (как в инвентаре).
local function icon_info(section)
    if icon_cache[section] ~= nil then
        return icon_cache[section] or nil
    end
    local info = false
    pcall(function()
        local ini = system_ini()
        if not ini:section_exist(section) then return end
        if not ini:line_exist(section, "icons_texture") then return end
        local tex = ini:r_string(section, "icons_texture")
        local gx = ini:line_exist(section, "inv_grid_x") and ini:r_int(section, "inv_grid_x") or 0
        local gy = ini:line_exist(section, "inv_grid_y") and ini:r_int(section, "inv_grid_y") or 0
        local gw = ini:line_exist(section, "inv_grid_width") and ini:r_int(section, "inv_grid_width") or 1
        local gh = ini:line_exist(section, "inv_grid_height") and ini:r_int(section, "inv_grid_height") or 1
        if gw <= 0 then gw = 1 end
        if gh <= 0 then gh = 1 end
        info = { tex = tex, x = gx * CELL, y = gy * CELL, w = gw * CELL, h = gh * CELL, gw = gw, gh = gh }
    end)
    icon_cache[section] = info
    return info or nil
end

-- Создаёт (один раз) статик иконки и статик текста с указанным именем.
local function ensure_static(store, index, name, suffix)
    local wnd = store[index]
    if wnd then return wnd end
    local hud = game_hud()
    if not hud then return nil end
    local ok, wnd_new = pcall(function()
        local s = hud:AddCustomStatic(name .. suffix, true)
        if not s then return nil end
        local w = s:wnd()
        if w then w:Show(false) end
        return w
    end)
    if ok and wnd_new then
        store[index] = wnd_new
        return wnd_new
    end
    return nil
end

-- Скрывает все элементы (например, когда пояса нет).
local function hide_all()
    for i = 1, MAX_ICONS do
        if statics[i] then pcall(function() statics[i]:Show(false) end) end
        if labels[i] then pcall(function() labels[i]:Show(false) end) end
    end
end

-- Основная функция: пересобрать панель по текущему состоянию актора.
--   artefacts - список предметов на поясе по порядку ячеек;
--   battery   - аккумулятор в своём слоте (может быть nil);
--   charge    - заряд аккумулятора 0..1.
function update(actor, artefacts, battery, charge)
    if not actor then return end
    local hud = game_hud()
    if not hud then return end

    local base_x = cfg_value(HUD_SECTION, "hud_x", 190)
    local base_y = cfg_value(HUD_SECTION, "hud_y", 700)
    local gap = cfg_value(HUD_SECTION, "icon_gap", ICON_GAP)

    -- Собираем то, что реально надо показать: артефакты по порядку, затем
    -- аккумулятор. Пустые ячейки не попадают в список вообще.
    local items = {}
    for i = 1, #artefacts do items[#items + 1] = artefacts[i] end
    if battery then items[#items + 1] = battery end

    local shown = 0
    for index, item in ipairs(items) do
        if index > MAX_ICONS then break end
        local section = item:section()
        local info = icon_info(section)
        if info then
            local wnd = ensure_static(statics, index, "bq_belt_hud_icon_", tostring(index))
            if wnd then
                local x = base_x + (index - 1) * (ICON_W + gap)
                local w = info.gw * ICON_W
                local h = info.gh * ICON_H
                local ok = pcall(function()
                    wnd:Init(info.tex, x, base_y, w, h)
                    wnd:SetTextureRect(info.x, info.y, info.w, info.h)
                    wnd:Show(true)
                end)
                if ok then
                    shown = shown + 1
                    -- Число заряда под аккумулятором (не подкрашиваем иконку).
                    if battery and item:id() == battery:id() then
                        local label = ensure_static(labels, index, "bq_belt_hud_text_", tostring(index))
                        if label then
                            local pct = math.floor((charge or 0) * 100 + 0.5)
                            pcall(function()
                                label:Init("ui\\ui_bq_blank", x, base_y + h + 1, w, 12)
                                label:SetText(string.format("%d%%", pct))
                                label:Show(true)
                            end)
                        end
                    end
                end
            end
        end
    end

    -- Прячем всё, что осталось от прошлого раза.
    for i = shown + 1, MAX_ICONS do
        if statics[i] then pcall(function() statics[i]:Show(false) end) end
        if labels[i] then pcall(function() labels[i]:Show(false) end) end
    end
    -- Текст под иконкой, которая перестала быть аккумулятором, тоже скрываем.
    for i = 1, shown do
        local item = items[i]
        local is_battery_slot = battery and item and item:id() == battery:id()
        if labels[i] and not is_battery_slot then
            pcall(function() labels[i]:Show(false) end)
        end
    end
end

-- Убрать панель совсем (при выходе с уровня).
function clear()
    hide_all()
end

-- ВАЖНО ПРО ЗАГРУЗКУ. Движок грузит скрипты ЛЕНИВО: файл исполняется только
-- тогда, когда его имя встречается в конфиге (CScriptEngine::process_file_if_exists,
-- script_engine.cpp:142), а не при старте (там грузится только _g.script, строка 209).
-- Поэтому наша панель обязана быть упомянута в конфиге - иначе таблицы bq_belt_hud
-- в Lua просто не будет. Ссылку держим в mod_game_global_z_bq.ltx, ключ
-- OnItemFocusLost: его результат движок игнорирует, так что вызов безвреден.
function touch()
    return true
end