-- bq_field_container.script
-- Полевой контейнер для артефактов.
--
-- Механика: игрок перетаскивает артефакт на контейнер в инвентаре.
-- Контейнер и артефакт исчезают, вместо них появляется комбо-предмет
-- "<секция артефакта>_field_container" (см. configs\misc\artefacts.ltx).
--
-- ПОЧЕМУ ЗАМЕНА ОТЛОЖЕННАЯ: менять инвентарь прямо внутри обработчика
-- перетаскивания нельзя — движок в этот момент сам правит список и падает.
-- Поэтому колбэк только запоминает id предметов и разрешает обычное
-- перекладывание (return true), а замена идёт на следующем кадре.
--
-- Точка входа — колбэк движка OnItemDropped, включается строкой в
-- configs\mod_game_global_z_bq.ltx:
--     ![callbacks]
--     OnItemDropped = bq_field_container.on_item_dropped
--
-- Все шаги пишутся в лог игры (ищите префикс [bq_fc]).

local CONTAINER_SECTION = "bq_field_container"
local SUFFIX            = "_field_container"

local pending = nil   -- { artifact_id, container_id, combo }
local hooked  = false

local function log_line(fmt, ...)
    log(string.format("[bq_fc] " .. fmt, ...))
end

-- Секция комбо-предмета для артефакта, если она есть в конфиге.
local function combo_section(artifact_section)
    if not artifact_section or artifact_section == CONTAINER_SECTION then
        return nil
    end
    local section = artifact_section .. SUFFIX
    if system_ini():section_exist(section) then
        return section
    end
    return nil
end

--------------------------------------------------------------------------
-- Замена. Выполняется на следующем кадре, когда движок уже закончил
-- обработку перетаскивания.
--------------------------------------------------------------------------
local function apply_pending()
    if not pending then return end
    if not db.actor or not alife() then return end
    if db.actor:is_talking() then return end

    local task = pending
    pending = nil

    local artifact  = alife():object(task.artifact_id)
    local container = alife():object(task.container_id)
    if not artifact or not container then
        log_line("отмена: предмет уже исчез")
        return
    end
    if artifact.parent_id ~= db.actor.id or container.parent_id ~= db.actor.id then
        log_line("отмена: предметы не у актора (artifact.parent=%s, container.parent=%s, actor=%s)",
            tostring(artifact.parent_id), tostring(container.parent_id), tostring(db.actor.id))
        return
    end

    -- Вершины берём у актора: они гарантированно валидны на текущей локации.
    local position     = db.actor:position()
    local level_vertex = db.actor:level_vertex_id()
    local game_vertex  = db.actor:game_vertex_id()

    log_line("замена: '%s'(%s) + контейнер(%s) -> '%s'",
        artifact:section_name(), tostring(task.artifact_id),
        tostring(task.container_id), task.combo)

    alife():release(artifact, true)
    alife():release(container, true)

    local created = alife():create(task.combo, position, level_vertex, game_vertex, db.actor.id)
    if created then
        log_line("готово: '%s' id=%s", task.combo, tostring(created.id))
    else
        log_line("ОШИБКА: не удалось создать '%s'", task.combo)
    end
end

--------------------------------------------------------------------------
-- Колбэк перетаскивания. Пишем всё, что приходит — по этим строкам видно,
-- вызывается ли колбэк вообще и с какими аргументами.
--------------------------------------------------------------------------
function on_item_dropped(first, second)
    if not db.actor or not alife() then return true end
    if not first or not second then
        log_line("вызов: пустые аргументы")
        return true
    end

    local sec_first  = first:section()
    local sec_second = second:section()
    log_line("вызов: тащим='%s' на='%s'", tostring(sec_first), tostring(sec_second))

    -- second — предмет, на который бросили, то есть контейнер.
    if sec_second ~= CONTAINER_SECTION then return true end

    local combo = combo_section(sec_first)
    if not combo then
        log_line("'%s' нельзя положить в контейнер (нет комбо-секции)", tostring(sec_first))
        return true
    end

    pending = { artifact_id = first:id(), container_id = second:id(), combo = combo }
    log_line("принято: '%s' -> контейнер, замена на следующем кадре", sec_first)
    return true
end

--------------------------------------------------------------------------
-- Хук обновления актора.
--------------------------------------------------------------------------
function on_game_start()
    if hooked then return end
    RegisterScriptCallback("update", apply_pending)
    hooked = true
    log_line("хук обновления установлен")
end

on_game_start()
