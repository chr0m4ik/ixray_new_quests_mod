-- bq_field_container.script
-- Контейнеры для артефактов: полевой, универсальный, научный.
--
-- ВЛОЖИТЬ: перетащить артефакт на пустой контейнер.
--   Контейнер и артефакт исчезают, появляется комбо-секция
--   "<артефакт>_<суффикс контейнера>" (см. configs\misc\artefacts.ltx).
-- ДОСТАТЬ: правый клик по комбо-предмету -> "Достать артефакт".
--
-- Почему замена отложенная: менять инвентарь прямо внутри обработчика
-- перетаскивания нельзя, движок в этот момент сам правит список.
--
-- Отладка: bq_container.log в корне игры (log() в игровой лог не попадает).

local SND_BY_CONTAINER = {
    bq_field_container = "interface\\inv_iam_open",
    bq_uni_container   = "interface\\inv_aac_open",
    bq_sci_container   = "interface\\inv_aam_open",
}

-- Суффиксы комбо-секций: <артефакт>_<суффикс>. Первым идёт самый длинный.
local COMBO_SUFFIXES = { "bq_sci_container", "bq_uni_container", "field_container" }

local LOG_FILE = "bq_container.log"

local pending   = nil
local hooked    = false
local snd_cache = {}

local function dbg(msg)
    local f = io.open(LOG_FILE, "a")
    if f then
        f:write(os.date("%H:%M:%S") .. "  " .. msg .. "\n")
        f:close()
    end
end

-- Проиграть звук (2D). Обёрнуто в pcall: битый звук не сорвёт замену.
local function play_sound(path)
    if not path then return end
    local ok, err = pcall(function()
        local snd = snd_cache[path]
        if not snd then
            snd = sound_object(path)
            snd_cache[path] = snd
        end
        if snd then
            snd:play_no_feedback(db.actor, sound_object.s2d, 0, vector():set(0, 0, 0), 1.0)
        else
            dbg("звук не загрузился: " .. path)
        end
    end)
    if not ok then dbg("ошибка звука '" .. path .. "': " .. tostring(err)) end
end

-- Секция комбо-предмета: <артефакт>_<суффикс> для любого типа контейнера.
local function combo_section(artifact_section)
    if not artifact_section then return nil end
    for _, suffix in ipairs(COMBO_SUFFIXES) do
        local candidate = artifact_section .. "_" .. suffix
        if system_ini():section_exist(candidate) then
            return candidate
        end
    end
    return nil
end

-- Секция пустого контейнера по секции комбо.
-- ВНИМАНИЕ: суффикс "field_container" не содержит префикса bq_, а
-- "bq_uni_container" и "bq_sci_container" — содержат. Раньше здесь было
-- "bq_" .. suffix, из-за чего получалось bq_bq_uni_container (секции нет),
-- и доставать артефакт получалось только из полевого контейнера.
local function container_of_combo(combo)
    if not combo then return nil end
    for _, suffix in ipairs(COMBO_SUFFIXES) do
        local n = string.len(suffix)
        if string.sub(combo, -(n + 1)) == "_" .. suffix then
            local container = (string.sub(suffix, 1, 3) == "bq_")
                and suffix or ("bq_" .. suffix)
            if system_ini():section_exist(container) then return container end
        end
    end
    return nil
end

-- Артефакт по секции комбо: отрезаем суффикс контейнера.
local function artifact_of_combo(combo)
    if not combo then return nil end
    for _, suffix in ipairs(COMBO_SUFFIXES) do
        local n = string.len(suffix)
        if string.sub(combo, -(n + 1)) == "_" .. suffix then
            local artifact = string.sub(combo, 1, -(n + 2))
            if system_ini():section_exist(artifact) then return artifact end
        end
    end
    return nil
end

local function owned_by_actor(object)
    return object and object.parent_id == db.actor:id()
end

--------------------------------------------------------------------------
-- Замена. Выполняется на следующем кадре.
--------------------------------------------------------------------------
local function do_apply()
    if not pending then return end
    local task = pending
    pending = nil

    local position     = db.actor:position()
    local level_vertex = db.actor:level_vertex_id()
    local game_vertex  = db.actor:game_vertex_id()

    if task.mode == "put" then
        local artifact  = alife():object(task.artifact_id)
        local container = alife():object(task.container_id)
        if not artifact or not container then
            dbg("ОТМЕНА(put): предмет исчез")
            return
        end
        if not owned_by_actor(artifact) or not owned_by_actor(container) then
            dbg("ОТМЕНА(put): не у актора")
            return
        end
        dbg("ЗАМЕНА(put): " .. artifact:section_name() .. " + " .. container:section_name() .. " -> " .. task.combo)
        alife():release(artifact, true)
        alife():release(container, true)
        local created = alife():create(task.combo, position, level_vertex, game_vertex, db.actor:id())
        dbg(created and ("  ГОТОВО id=" .. tostring(created.id)) or "  ОШИБКА создания комбо")
        if created then play_sound(task.sound) end

    elseif task.mode == "take" then
        local combo = alife():object(task.combo_id)
        if not combo then
            dbg("ОТМЕНА(take): комбо исчез id=" .. tostring(task.combo_id))
            return
        end
        if not owned_by_actor(combo) then
            dbg("ОТМЕНА(take): комбо не у актора parent=" .. tostring(combo.parent_id) .. " actor=" .. tostring(db.actor:id()))
            return
        end
        dbg("ЗАМЕНА(take): " .. combo:section_name() .. " -> " .. task.artifact .. " + " .. task.container)
        alife():release(combo, true)
        local artifact  = alife():create(task.artifact, position, level_vertex, game_vertex, db.actor:id())
        local container = alife():create(task.container, position, level_vertex, game_vertex, db.actor:id())
        dbg((artifact and container) and "  ГОТОВО" or "  ОШИБКА при доставании")
        if artifact and container then play_sound(task.sound) end
    end
end

local function apply_pending()
    if not pending then return end
    if not db.actor or not alife() then return end
    if db.actor:is_talking() then return end
    local ok, err = pcall(do_apply)
    if not ok then
        pending = nil
        dbg("ОШИБКА в apply_pending: " .. tostring(err))
    end
end
-- 1) Перетаскивание: артефакт на пустой контейнер.
--------------------------------------------------------------------------
function on_item_dropped(first, second)
    if not db.actor or not alife() then return true end
    if not first or not second then
        dbg("OnItemDropped: пустые аргументы")
        return true
    end

    local sec_first  = first:section()
    local sec_second = second:section()
    dbg("OnItemDropped: тащим='" .. tostring(sec_first) .. "' на='" .. tostring(sec_second) .. "'")

    local sound = SND_BY_CONTAINER[sec_second]
    if not sound then return true end          -- цель не контейнер

    local combo = combo_section(sec_first)
    if not combo then
        dbg("  '" .. tostring(sec_first) .. "' не подходит (нет комбо-секции)")
        return true
    end

    pending = { mode = "put", artifact_id = first:id(), container_id = second:id(),
                combo = combo, sound = sound }
    dbg("  принято: вложение на следующем кадре")
    return true
end

--------------------------------------------------------------------------
-- 2) Кнопка на комбо-предмете: достать артефакт.
--------------------------------------------------------------------------
function take_artifact(combo)
    dbg("take_artifact: вызов из меню")
    if not db.actor or not alife() or not combo then return false end

    local combo_sec = combo:section()
    local artifact  = artifact_of_combo(combo_sec)
    local container = container_of_combo(combo_sec)
    local sound     = container and SND_BY_CONTAINER[container] or nil
    if not artifact or not container then
        dbg("  '" .. tostring(combo_sec) .. "' не распознан как комбо")
        return false
    end

    pending = { mode = "take", combo_id = combo:id(), artifact = artifact,
                container = container, sound = sound }
    dbg("  '" .. combo_sec .. "' -> '" .. artifact .. "' + '" .. container .. "'")
    return false
end

--------------------------------------------------------------------------
-- Хук обновления актора.
--------------------------------------------------------------------------
function on_game_start()
    if hooked then return end
    RegisterScriptCallback("update", apply_pending)
    hooked = true
    dbg("==== скрипт контейнеров загружен (3 типа), хук установлен ====")
end

on_game_start()