-- bq_field_container.script
-- Полевой контейнер для артефактов.
--
-- ВЛОЖИТЬ: перетащить артефакт на пустой контейнер в инвентаре.
--   Контейнер и артефакт исчезают, появляется комбо-предмет
--   "<секция артефакта>_field_container".
-- ДОСТАТЬ: правый клик по комбо-предмету -> "Достать артефакт".
--   Комбо исчезает, возвращаются артефакт и пустой контейнер.
--
-- ПОЧЕМУ ЗАМЕНА ОТЛОЖЕННАЯ: менять инвентарь прямо внутри обработчика
-- перетаскивания нельзя — движок в этот момент сам правит список и падает.
-- Поэтому сначала запоминаем id предметов, а меняем на следующем кадре.
--
-- Отладка: bq_container.log в корне игры (log() в игровой лог не попадает).

local CONTAINER_SECTION = "bq_field_container"
local SUFFIX            = "_field_container"
local LOG_FILE          = "bq_container.log"

local pending = nil   -- { artifact_id, container_id, combo } либо take-задача
local hooked  = false

local function dbg(msg)
    local f = io.open(LOG_FILE, "a")
    if f then
        f:write(os.date("%H:%M:%S") .. "  " .. msg .. "\n")
        f:close()
    end
end

-- Секция комбо-предмета для артефакта, если она есть в конфиге.
local function combo_section(artifact_section)
    if not artifact_section or artifact_section == CONTAINER_SECTION then
        return nil
    end
    local section = artifact_section .. SUFFIX
    if system_ini():section_exist(section) then
        return section
    end
    return nil
end

-- Обратная операция: секция артефакта по секции комбо-предмета.
local function artifact_from_combo(combo)
    if not combo then return nil end
    local n = string.len(SUFFIX)
    if string.sub(combo, -n) ~= SUFFIX then return nil end
    local base = string.sub(combo, 1, -(n + 1))
    if system_ini():section_exist(base) then return base end
    return nil
end

-- Первый подходящий артефакт у актора (для кнопки на заполненном контейнере).
local function first_artifact_in_inventory()
    if not db.actor then return nil, nil end
    local found_id, found_section = nil, nil
    local function iter(_, item)
        if found_id or not item then return end
        local s = item:section()
        if combo_section(s) then
            found_id = item:id()
            found_section = s
        end
    end
    db.actor:iterate_inventory(iter, db.actor)
    return found_id, found_section
end

-- Артефакт и контейнер лежат у актора? (db.actor.id — это функция, нужен :id())
local function owned_by_actor(object)
    return object and object.parent_id == db.actor:id()
end

--------------------------------------------------------------------------
-- Замена. Выполняется на следующем кадре.
--------------------------------------------------------------------------
local function apply_pending()
    if not pending then return end
    if not db.actor or not alife() then return end
    if db.actor:is_talking() then return end

    local task = pending
    pending = nil

    local position     = db.actor:position()
    local level_vertex = db.actor:level_vertex_id()
    local game_vertex  = db.actor:game_vertex_id()

    if task.mode == "put" then
        local artifact  = alife():object(task.artifact_id)
        local container = alife():object(task.container_id)
        if not artifact or not container then
            dbg("ОТМЕНА(put): предмет исчез")
            return
        end
        if not owned_by_actor(artifact) or not owned_by_actor(container) then
            dbg("ОТМЕНА(put): не у актора (artifact=" .. tostring(artifact.parent_id)
                .. ", container=" .. tostring(container.parent_id)
                .. ", actor=" .. tostring(db.actor:id()) .. ")")
            return
        end
        dbg("ЗАМЕНА(put): '" .. artifact:section_name() .. "' + контейнер -> '" .. task.combo .. "'")
        alife():release(artifact, true)
        alife():release(container, true)
        local created = alife():create(task.combo, position, level_vertex, game_vertex, db.actor:id())
        dbg(created and ("  ГОТОВО: id=" .. tostring(created.id)) or "  ОШИБКА создания комбо")

    elseif task.mode == "take" then
        local combo = alife():object(task.combo_id)
        if not combo then
            dbg("ОТМЕНА(take): комбо-предмет исчез")
            return
        end
        if not owned_by_actor(combo) then
            dbg("ОТМЕНА(take): комбо не у актора (" .. tostring(combo.parent_id) .. ")")
            return
        end
        dbg("ЗАМЕНА(take): '" .. combo:section_name() .. "' -> '" .. task.artifact .. "' + контейнер")
        alife():release(combo, true)
        local artifact  = alife():create(task.artifact, position, level_vertex, game_vertex, db.actor:id())
        local container = alife():create(CONTAINER_SECTION, position, level_vertex, game_vertex, db.actor:id())
        dbg((artifact and container) and "  ГОТОВО"
            or ("  ОШИБКА: artifact=" .. tostring(artifact) .. ", container=" .. tostring(container)))
    end
end

--------------------------------------------------------------------------
-- 1) Перетаскивание: артефакт на пустой контейнер.
--------------------------------------------------------------------------
function on_item_dropped(first, second)
    if not db.actor or not alife() then return true end
    if not first or not second then
        dbg("OnItemDropped: пустые аргументы")
        return true
    end

    local sec_first  = first:section()
    local sec_second = second:section()
    dbg("OnItemDropped: тащим='" .. tostring(sec_first) .. "' на='" .. tostring(sec_second) .. "'")

    if sec_second ~= CONTAINER_SECTION then return true end

    local combo = combo_section(sec_first)
    if not combo then
        dbg("  '" .. tostring(sec_first) .. "' не подходит (нет комбо-секции)")
        return true
    end

    pending = { mode = "put", artifact_id = first:id(), container_id = second:id(), combo = combo }
    dbg("  принято: вложение на следующем кадре")
    return true
end

--------------------------------------------------------------------------
-- 2) Кнопка на комбо-предмете: достать артефакт.
--    Движок передаёт в функцию сам предмет (комбо-контейнер).
--------------------------------------------------------------------------
function take_artifact(combo)
    dbg("take_artifact: вызов из меню")
    if not db.actor or not alife() or not combo then return false end

    local combo_section_name = combo:section()
    local artifact = artifact_from_combo(combo_section_name)
    if not artifact then
        dbg("  '" .. tostring(combo_section_name) .. "' не комбо-секция")
        return false
    end

    pending = { mode = "take", combo_id = combo:id(), artifact = artifact }
    dbg("  '" .. combo_section_name .. "' -> '" .. artifact .. "', замена на следующем кадре")
    return false
end

--------------------------------------------------------------------------
-- 3) Кнопка на пустом контейнере: положить первый подходящий артефакт.
--------------------------------------------------------------------------
function put_artifact(container)
    dbg("put_artifact: вызов из меню")
    if not db.actor or not alife() or not container then return false end
    if container:section() ~= CONTAINER_SECTION then return false end

    local artifact_id, artifact_section = first_artifact_in_inventory()
    if not artifact_id then
        dbg("  подходящих артефактов в инвентаре нет")
        return false
    end

    pending = { mode = "put", artifact_id = artifact_id, container_id = container:id(),
                combo = combo_section(artifact_section) }
    dbg("  взял '" .. artifact_section .. "', замена на следующем кадре")
    return false
end

--------------------------------------------------------------------------
-- Хук обновления актора.
--------------------------------------------------------------------------
function on_game_start()
    if hooked then return end
    RegisterScriptCallback("update", apply_pending)
    hooked = true
    dbg("==== скрипт контейнера загружен, хук обновления установлен ====")
end

on_game_start()
