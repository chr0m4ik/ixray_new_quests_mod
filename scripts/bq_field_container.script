-- bq_field_container.script
-- Полевой контейнер для артефактов.
--
-- Механика: игрок перетаскивает артефакт на контейнер в рюкзаке.
-- Контейнер и артефакт исчезают, вместо них в рюкзаке появляется
-- комбо-предмет "<секция артефакта>_field_container" (наследник артефакта
-- с изменённой радиацией, см. configs\misc\artefacts.ltx).
--
-- Точка входа — глобальный колбэк движка OnItemDropped. Он вызывается из
-- CUIActorMenu::OnItemDrop (см. исходники ixray-1.6-stcop,
-- src/xrGame/ui/UIActorMenu_action.cpp) при перетаскивании одного предмета
-- на другой внутри одного списка. Чтобы движок его вызывал, в
-- configs\mod_game_global_z_bq.ltx прописано:
--     [callbacks]
--     OnItemDropped = bq_field_container.on_item_dropped
-- Возврат false отменяет стандартную обработку перетаскивания.

local CONTAINER_SECTION = "bq_field_container"
local SUFFIX            = "_field_container"

-- Движок вызывает колбэк дважды за одно перетаскивание (до и после
-- обработки дропа), поэтому от повторного срабатывания защищаемся флагом.
local busy = false

local function log_line(fmt, ...)
    log(string.format("[bq_fc] " .. fmt, ...))
end

-- Секция комбо-предмета для артефакта, если она есть в конфиге.
local function combo_section(artifact_section)
    local section = artifact_section .. SUFFIX
    if system_ini():section_exist(section) then
        return section
    end
    return nil
end

-- Артефакт ли это (по наличию комбо-секции; контейнеры и комбо-предметы
-- сами по себе комбо-секции не имеют).
local function is_plain_artifact(section)
    if not section or section == CONTAINER_SECTION then return false end
    return combo_section(section) ~= nil
end

-- Пробуем разные способы получить объект, чтобы не зависеть от того,
-- что именно движок передал в колбэк (клиентский или серверный объект).
local function resolve_server_object(obj)
    if not obj then return nil end
    local id = obj:id()
    if not id then return nil end
    local server = alife():object(id)
    if server and server:section_name() == obj:section() then
        return server
    end
    return nil
end

local function release_object(obj)
    local server = resolve_server_object(obj)
    if server then
        alife():release(server, true)
    end
end

-- Кладём комбо-предмет в рюкзак актора.
local function give_to_actor(section, position, level_vertex, game_vertex)
    local created = alife():create(section, position, level_vertex, game_vertex, db.actor.id)
    if not created then
        log_line("не удалось создать '%s'", section)
        return nil
    end
    local client = level.object_by_id(created.id)
    if client then
        client:use_ai_locations(false)
    end
    return created
end

-- Вызывается движком до обработки перетаскивания.
-- first  — перетаскиваемый предмет (артефакт),
-- second — предмет под курсором (контейнер).
function on_item_dropped(first, second)
    if busy then return true end
    if not db.actor or not alife() then return true end
    if not first or not second then return true end

    local target_section = second:section()
    if target_section ~= CONTAINER_SECTION then
        return true
    end

    local item_section = first:section()
    if not is_plain_artifact(item_section) then
        log_line("'%s' нельзя положить в контейнер (нет комбо-секции)",
            tostring(item_section))
        return false
    end

    local combo = combo_section(item_section)
    busy = true
    local ok = false

    local position     = first:position()
    local level_vertex = first:level_vertex_id()
    local game_vertex  = first:game_vertex_id()

    release_object(first)
    release_object(second)

    if give_to_actor(combo, position, level_vertex, game_vertex) then
        ok = true
        log_line("'%s' + контейнер -> '%s'", item_section, combo)
    end

    busy = false
    -- false отменяет стандартную обработку дропа: предметы уже заменены.
    return not ok
end
