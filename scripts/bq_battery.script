-- bq_battery.script
-- Пояс артефактов работает ТОЛЬКО если в слоте аккумулятора лежит аккумулятор.
--
-- ЗАДАЧА (пункт 2 плана): без аккумулятора в слоте пояс не даёт ничего, при
-- этом сам аккумулятор и броня (костюм) работают как обычно.
--
-- СЛОТ. Это CUSTOM_SLOT_1 = 14 (inventory_space.h:23-33). Предметы получают его
-- ключом slot = 13 (inventory_item.cpp:165-166: base_slot_id = slot + 1).
-- Состояние слота (slot_persistent_14 / slot_active_14) - в
-- configs\mod_system_z_bq.ltx, ячейка интерфейса - в configs\ui\mod_actor_menu*_z_bq.xml.
--
-- ПОЧЕМУ ГЛУШИМ ЧЕРЕЗ condition, А НЕ ЧЕРЕЗ set_artefact_*.
-- Движок умножает ВСЕ вклады артефакта с пояса на его condition:
--   * эффекты:      Actor.cpp:2608-2630 (здоровье, силы, сытость, жажда,
--                   кровотечение, радиация), ActorCondition.cpp:1190-1197,
--                   CActor::GetRestoreSpeed Actor.cpp:2849-2943;
--   * защиты:       CActor::HitArtefactsOnBelt Actor.cpp:2643-2654,
--                   CActor::GetProtection_ArtefactsOnBelt Actor.cpp:2674-2687;
--   * доп. вес:     Actor_Movement.cpp:771-777.
-- Поэтому condition = 0 выключает пояс ЦЕЛИКОМ.
--
-- Lua-сеттеры set_artefact_health / radiation / satiety / thirst / power /
-- bleeding (script_game_object_script3.cpp:267-279) закрывают только эффекты:
-- сеттеров для иммунитетов и доп. веса в сборке НЕТ (проверено поиском по всем
-- Lua-биндингам). Поэтому выбран condition - одна ручка на всё.
--
-- ПОЧЕМУ ЭТО НЕЗАМЕТНО И БЕЗОПАСНО:
--   * у артефактов нет ключа use_condition, значит полоски состояния в ячейке
--     нет (inventory_item.cpp:178, UICellItem.cpp:312);
--   * у артефактов нет ключа degrade_rate, значит строка "состояние" в окне
--     артефакта не показывается (ui_af_params.cpp:215) и износа нет
--     (Actor.cpp:1878, 1979);
--   * костюм (броня) - ОТДЕЛЬНЫЙ объект и отдельная ветка кода, к нему мы не
--     прикасаемся вообще: глушим только артефакты, лежащие НА ПОЯСЕ.
-- Настоящее значение запоминаем (в _G и в pstor) и возвращаем, как только
-- аккумулятор вставлен или артефакт ушёл с пояса.
--
-- КАК МЕХАНИКА ЗАГРУЖАЕТСЯ И ТИКАЕТ.
--   1. Загрузка: ключ start_game_callback в [alife] (alife_simulator.cpp:81-84) -
--      движок сам зовёт нашу функцию при старте игры и загрузке сейва. Это
--      обязательно: scripts\*.script в этой сборке исполняются только при
--      обращении по имени (MEMO 33.7). Внутри сначала вызывается ВАНИЛЬНЫЙ
--      _G.start_game_callback (_g.script:514), иначе игра останется без неё.
--   2. Кадры: свой объект-турер [bq_battery_tuner] со своим script_binding.
--      Метод update биндера зовёт ПЛАНИРОВЩИК каждый кадр
--      (CGameObject::shedule_Update -> CScriptBinder::shedule_Update, MEMO 35.2),
--      это не зависит от реестра колбэков, который теряется при пересоздании
--      Lua-машины (MEMO 31.3, 35.1). Так же сделана радиация в рюкзаке.
--      Внутри update две скорости:
--        * КАЖДЫЙ КАДР - fast_belt_check: обход только пояса (<= 5 предметов),
--          гасит/возвращает состояние сразу. Это убирает видимый «скачок статов»,
--          который получался, пока реакция была только раз в 300 мс: движок
--          применяет пояс раз в 100 мс (Actor.cpp:2589-2607) и успевал отдать
--          статы артефакта до нашего пересчёта;
--        * раз в PERIOD_MS (300 мс) - полный проход по инвентарю: возврат
--          состояния предметам не на поясе (нужно для радиации в рюкзаке),
--          выброшенные предметы, диагностика в лог.
--   3. Резерв: свободные ключи [callbacks] OnItemFocusLost / OnZoneTouch /
--      OnBeforeHit (mod_game_global_z_bq.ltx) снова создают турер после перехода
--      на другую локацию - при переходе движок уничтожает все объекты уровня.
--
-- ОТЛАДКА: log() из скриптов аддона в игровой лог не попадает (MEMO 13.5),
-- поэтому пишем в bq_battery.log в корне игры. Лог включён на время проверки
-- механики в игре (пункт 2), перед релизом его надо выключить (DEBUG = false).

-- Отладочный лог. При DEBUG = false dbg не делает ничего.
local DEBUG = true
local LOG_FILE = "bq_battery.log"

-- Периодичность проверки, мс (решение заказчика: 300 мс).
local PERIOD_MS = 300

-- Секция турера (см. configs\misc\mod_artefacts_z_bq.ltx).
local TUNER_SECTION = "bq_battery_tuner"

-- Слот аккумулятора: CUSTOM_SLOT_1 = 14 (первый кастомный слот движка).
local BATTERY_SLOT = 14

-- Ключ-маркер аккумулятора в его секции (configs\misc\mod_batteries_z_bq.ltx).
local MARKER_KEY = "bq_battery"

-- Префикс ключа pstor, в котором лежит настоящее состояние артефакта.
local PSTOR_PREFIX = "bq_batt_cond_"

----------------------------------------------------------------------------
-- Отладка: пишем в файл в корне игры (log() в игровой лог не попадает).
----------------------------------------------------------------------------
local function dbg(msg)
    if not DEBUG then return end
    local f = io.open(LOG_FILE, "a")
    if f then
        f:write(os.date("%H:%M:%S") .. "  " .. msg .. "\n")
        f:close()
    end
end

----------------------------------------------------------------------------
-- Состояние механизма. Живёт в _G: движок исполняет .script повторно (новый
-- экземпляр модуля), а таблица _G при этом сохраняется, поэтому локальные
-- переменные модуля для разделяемого состояния не годятся (MEMO 31.2, 35.1).
--
-- Поля нельзя считать созданными: старая таблица переживает обновление скрипта,
-- поэтому normalize_state явно выставляет всё нужное (иначе вылет вида
-- "attempt to perform arithmetic on field 'cycles'", MEMO 35.1).
----------------------------------------------------------------------------
_G.bq_battery = _G.bq_battery or {}

local function normalize_state()
    local st = _G.bq_battery
    st.tuner_id     = st.tuner_id     or nil
    st.next_tick    = st.next_tick    or nil
    st.cycles       = st.cycles       or 0
    st.last_log     = st.last_log     or 0
    st.hidden       = st.hidden       or {}      -- id -> настоящее condition
    st.powered      = st.powered                       -- nil = ещё не знаем
    st.logged_power = st.logged_power
    st.last_status  = st.last_status  or 0
    st.last_error   = st.last_error   or 0
    return st
end

normalize_state()

----------------------------------------------------------------------------
-- Чтение конфига. СТРОГО: section_exist -> line_exist -> r_*.
-- Без проверок r_string/r_bool делает VERIFY3, а это Debug.fatal - мгновенное
-- завершение игры, которое pcall НЕ ловит (MEMO 35.3, проверено вылетом).
----------------------------------------------------------------------------
local section_cache = {}

local function section_class(section)
    if not section then return nil end
    local cached = section_cache[section]
    if cached ~= nil then return cached or nil end

    local value = false
    local ok, res = pcall(function()
        local ini = system_ini()
        if not ini:section_exist(section) then return false end
        if not ini:line_exist(section, "class") then return false end
        return ini:r_string(section, "class")
    end)
    if ok and type(res) == "string" then value = res end

    section_cache[section] = value
    return value or nil
end

local function is_artefact(section)
    local class = section_class(section)
    return class == "ARTEFACT" or class == "SCRPTART"
end

-- Аккумулятор определяем по маркеру bq_battery в его секции. Это надёжнее, чем
-- сравнение имён секций: в пункте 5 аккумуляторов станет несколько.
local function is_battery(section)
    if not section then return false end
    local cached = section_cache["battery:" .. section]
    if cached ~= nil then return cached == true end

    local value = false
    local ok, res = pcall(function()
        local ini = system_ini()
        if not ini:section_exist(section) then return false end
        if not ini:line_exist(section, MARKER_KEY) then return false end
        return ini:r_bool(section, MARKER_KEY)
    end)
    if ok and res == true then value = true end

    section_cache["battery:" .. section] = value
    return value
end

----------------------------------------------------------------------------
-- Настоящее состояние артефакта: храним в _G и в pstor актора.
-- pstor (xr_logic.pstor_store/retrieve) сохраняется в сейве, поэтому состояние
-- не потеряется, если игрок сохранится без аккумулятора. Ключ на каждый предмет
-- свой, снимаем его сразу после возврата состояния.
----------------------------------------------------------------------------
local function pstor_key(id)
    return PSTOR_PREFIX .. tostring(id)
end

local function remember_condition(id, value)
    local st = normalize_state()
    st.hidden[id] = value
    if db.actor then xr_logic.pstor_store(db.actor, pstor_key(id), value) end
end

local function saved_condition(id)
    local st = normalize_state()
    local value = st.hidden[id]
    if value == nil and db.actor then
        local stored = xr_logic.pstor_retrieve(db.actor, pstor_key(id), nil)
        if type(stored) == "number" then value = stored end
    end
    return value
end

local function forget_condition(id)
    local st = normalize_state()
    st.hidden[id] = nil
    if db.actor then xr_logic.pstor_store(db.actor, pstor_key(id), nil) end
end

----------------------------------------------------------------------------
-- Сам механизм.
----------------------------------------------------------------------------
-- МЕХАНИКА РАЗРЯДА И ВЫПАДЕНИЯ (пункт 4-5). Параметры - в
-- configs\misc\mod_battery_rules_z_bq.ltx.
-- ВАЖНО: эти константы объявлены ЗДЕСЬ, выше cfg_float/discharge_mult, которые
-- их используют. В Lua local виден только после объявления, иначе получается
-- обращение к глобальной переменной = nil (на этом уже один раз сломалась
-- механика: пояс не включался и заряд не убывал).
local DISCHARGE_SECTION = "bq_battery_discharge"
local DROP_SECTION = "bq_battery_drop"

-- Читает число из конфига без риска Debug.fatal: сначала section_exist, потом
-- line_exist, и только затем r_float (MEMO 35.3 - иначе движок падает).
-- ВАЖНО: system_ini() берём ЗДЕСЬ, локально. Раньше функция пользовалась
-- переменной ini, а она объявлена как local ВНУТРИ section_class/is_battery -
-- на верхнем уровне её нет, поэтому ini был nil, pcall глотал ошибку, и
-- discharge_days всегда читался как 0: разряд молча ничего не делал (сеанс 36).
local cfg_errors = {}
local function cfg_float(section, key, default)
    local ok, value = pcall(function()
        local ini = system_ini()
        if not ini:section_exist(section) then return nil end
        if not ini:line_exist(section, key) then return nil end
        return ini:r_float(section, key)
    end)
    if ok and type(value) == "number" then return value end
    -- Один раз на ключ пишем в лог: иначе такая ошибка снова спрячется.
    local tag = tostring(section) .. "." .. tostring(key)
    if not cfg_errors[tag] then
        cfg_errors[tag] = true
        dbg(string.format("не смог прочитать %s (значение по умолчанию %s)", tag, tostring(default)))
    end
    return default
end

-- То же, но строка (путь звука и т.п.).
local function cfg_string(section, key, default)
    local ok, value = pcall(function()
        local ini = system_ini()
        if not ini:section_exist(section) then return nil end
        if not ini:line_exist(section, key) then return nil end
        return ini:r_string(section, key)
    end)
    if ok and type(value) == "string" then return value end
    return default
end

-- Множитель разряда по числу артефактов на поясе (0..5).
local function discharge_mult(count)
    if count > 5 then count = 5 end
    return cfg_float(DISCHARGE_SECTION, "mult_" .. count, 1.0)
end

local function battery_in_slot(actor)
    local item = actor:item_in_slot(BATTERY_SLOT)
    if not item then return false, nil end
    local section = item:section()
    if not is_battery(section) then return false, section end
    -- Разряженный в ноль аккумулятор пояс не держит (решение заказчика):
    -- ведём себя так, будто его в слоте нет.
    -- ВАЖНО: состояние читаем ЗДЕСЬ напрямую, а не через local get_condition -
    -- он объявлен ниже, и вызов до объявления уходил бы в глобальную (nil).
    local charge
    local ok = pcall(function() charge = item:condition() end)
    if ok and type(charge) == "number" and charge <= 0 then return false, section end
    return true, section
end

local function get_condition(item)
    local ok, value = pcall(function() return item:condition() end)
    if ok and type(value) == "number" then return value end
    return nil
end

local function set_condition(item, value)
    pcall(function() item:set_condition(value) end)
end

-- ОСЛАБЛЕНИЕ ПОЯСА ПО МЕРЕ РАЗРЯДА (решение заказчика, 10.10.2026).
-- Пояс отдаёт вклад артефактов не полностью, а по заряду аккумулятора:
--   множитель = weak_min_factor + (1 - weak_min_factor) * заряд
-- (100% -> 1.0, около нуля -> weak_min_factor, по умолчанию 0.5).
-- Движок умножает на condition артефакта эффекты, защиту и вес, поэтому другой
-- ручки не нужно. Если аккумулятора в слоте нет - возвращаем 1.0, питание
-- всё равно отсекает powered (артефакты просто гасятся в 0).
local function belt_factor()
    local actor = db.actor
    if not actor then return 1.0 end
    local item = actor:item_in_slot(BATTERY_SLOT)
    if not item or not is_battery(item:section()) then return 1.0 end
    local charge = get_condition(item)
    if charge == nil then return 1.0 end
    if charge > 1 then charge = 1 end
    if charge <= 0 then return 0 end
    local weak = cfg_float(DISCHARGE_SECTION, "weak_min_factor", 0.5)
    if weak < 0 then weak = 0 end
    if weak > 1 then weak = 1 end
    return weak + (1 - weak) * charge
end

-- ОБНОВЛЕНИЕ ПОЛОСОК В ОТКРЫТОМ ОКНЕ АКТОРА.
-- Движок пересчитывает полоски состояния слотов только при своих действиях
-- (CUIActorMenu::UpdateConditionProgressBars, UIActorMenu.cpp:1018-1025: вызов
-- из SetMenuMode и обработчиков мыши), поэтому после нашего set_condition
-- значение в интерфейсе остаётся старым до переоткрытия инвентаря - это и видел
-- заказчик. Метод отдан в Lua (UIActorMenu_script.cpp:464), зовём его сами.
local function refresh_ui()
    if type(get_actor_menu) ~= "function" then return end
    pcall(function()
        local menu = get_actor_menu()
        if menu and menu.UpdateConditionProgressBars then
            menu:UpdateConditionProgressBars()
        end
    end)
end

-- ЗВУК ПДА ПРИ ПОЛНОМ РАЗРЯДЕ. Файл: sounds\device\bq_pda_alarm.ogg (из Anomaly),
-- путь к нему - ключ alarm_sound в configs\misc\mod_battery_rules_z_bq.ltx.
local alarm_snd = nil
local alarm_tried = false
local function play_alarm()
    local name = cfg_string(DISCHARGE_SECTION, "alarm_sound", "device\\bq_pda_alarm")
    if name == nil or name == "" then return end

    if not alarm_tried then
        alarm_tried = true
        local ok, snd = pcall(function() return sound_object(name) end)
        if not ok or not snd then
            ok, snd = pcall(function() return xr_sound.get_safe_sound_object(name) end)
        end
        if ok and snd then alarm_snd = snd else dbg("не смог загрузить звук " .. tostring(name)) end
    end
    if not alarm_snd then return end

    pcall(function()
        local flag = sound_object and sound_object.s2d
        if flag ~= nil then
            alarm_snd:play(db.actor, 0, flag)
        else
            alarm_snd:play(db.actor)
        end
    end)
end

-- Один проход по инвентарю актора.
-- ВАЖНО: колбэк iterate_inventory НЕ должен вернуть true - это немедленно
-- оборвёт перебор (script_game_object_inventory_owner.cpp:276-279).
local function apply_gate(actor, powered)
    local st = normalize_state()
    local stats = { belt = 0, artefacts = 0, hidden = 0, restored = 0 }
    local seen = {}      -- id предметов, которые сейчас у актора
    local factor = powered and belt_factor() or 0

    actor:iterate_inventory(function(owner, item)
        if not item then return end

        local section = item:section()
        if not is_artefact(section) then return end

        local id = item:id()
        seen[id] = true
        local on_belt = owner:is_on_belt(item)
        stats.artefacts = stats.artefacts + 1
        if on_belt then stats.belt = stats.belt + 1 end

        if on_belt then
            -- На поясе: настоящий вклад берём из записи (если мы его уже
            -- ослабляли), иначе - текущее состояние предмета.
            local real = saved_condition(id)
            if real == nil then
                real = get_condition(item)
                if real == nil or real <= 0 then
                    -- Ноль без записи = сейв от упавшей сборки (артефакты в этой
                    -- сборке не изнашиваются, значит 0 мог поставить только скрипт).
                    real = 1.0
                end
            end
            local target = real * factor
            if get_condition(item) ~= target then
                set_condition(item, target)
                if target == 0 then
                    stats.hidden = stats.hidden + 1
                    dbg(string.format("спрятал состояние %s (id=%d), было %.3f", section, id, real))
                else
                    stats.restored = stats.restored + 1
                    dbg(string.format("вклад %s (id=%d): %.3f -> %.3f (пояс %.0f%%)",
                        section, id, real, target, factor * 100))
                end
            end
            if factor >= 0.999 then
                forget_condition(id)          -- полный заряд: запись не нужна
            else
                remember_condition(id, real)  -- помним НАСТОЯЩЕЕ значение
            end
        else
            -- Не на поясе: возвращаем настоящее значение, если мы его меняли.
            local real = saved_condition(id)
            if real ~= nil and real > 0 then
                if get_condition(item) ~= real then
                    set_condition(item, real)
                    stats.restored = stats.restored + 1
                    dbg(string.format("вернул состояние %s (id=%d) = %.3f", section, id, real))
                end
                forget_condition(id)
            end
        end
    end, actor)

    return stats, seen
end

-- Если игрок выбросил артефакт, пока пояс был выключен, объект остался с
-- нулевым состоянием. Возвращаем ему настоящее значение и убираем запись.
--
-- ВАЖНО: предметы, которые всё ещё у актора (seen), пропускаем - иначе мы
-- вернули бы состояние только что спрятанному артефакту на поясе (у предметов
-- в инвентаре тоже есть клиентский объект, и level.object_by_id его находит).
--
-- Достать выброшенный предмет можно только клиентским объектом:
-- level.object_by_id(id) (level_script.cpp:201,1501). Если предмет ушёл в
-- офлайн (далеко или на другой локации), клиентского объекта нет - тогда запись
-- НЕ удаляем: состояние вернётся, когда предмет снова попадёт в инвентарь
-- актора (ветка возврата в apply_gate).
local function restore_orphans(seen)
    local st = normalize_state()
    for id, value in pairs(st.hidden) do
        if not seen[id] then
            local object = level.object_by_id(id)
            if object then
                pcall(function() object:set_condition(value) end)
                st.hidden[id] = nil
                if db.actor then xr_logic.pstor_store(db.actor, pstor_key(id), nil) end
                dbg(string.format("вернул состояние выброшенному предмету id=%d = %.3f", id, value))
            end
        end
    end
end

----------------------------------------------------------------------------
-- БЫСТРАЯ проверка пояса - вызывается КАЖДЫЙ КАДР из update биндера.
--
-- ЗАЧЕМ. Движок применяет статы пояса раз в 100 мс
-- (ARTEFACTS_UPDATE_TIME = 0.100f, Actor.cpp:2589-2607), а полный проход у нас
-- раз в PERIOD_MS (300 мс). Из-за этого артефакт, только что положенный на пояс
-- без аккумулятора, успевал отдать свои статы, и лишь потом мы гасили их -
-- в интерфейсе это видно как «статы подскочили и вернулись назад» (замечание
-- заказчика 09.10.2026). Здесь состояние гасится в ТОМ ЖЕ кадре, когда артефакт
-- появился на поясе, поэтому до следующего пересчёта движка вклад уже нулевой.
--
-- Что делает:
--   1. пояс без аккумулятора  -> condition артефактов на поясе в 0;
--   2. пояс с аккумулятором   -> возврат настоящего condition;
--   3. предмет убрали с пояса -> состояние возвращается сразу же (чтобы предмет
--      не остался «пустым» в рюкзаке/на продаже). Для этого используется запись
--      из hidden: объект достаётся клиентским level.object_by_id(id), а если
--      объекта уже нет (вложили в контейнер - вместо него создано комбо),
--      запись просто убирается.
--
-- ПОЧЕМУ ЭТО ДЕШЕВО. Перебирается только пояс (максимум 5 предметов, размер
-- пояса задаёт костюм) плюс несколько записей в hidden - не весь инвентарь.
--
-- ВАЖНО: обход пояса идёт индексами 0..belt_count()-1. У item_on_belt
-- проверка границы написана как "belt.size() < item_id"
-- (script_game_object_inventory_owner.cpp:2066), поэтому индекс, равный размеру,
-- уже выбросил бы ошибку - так делать нельзя.
----------------------------------------------------------------------------
local function fast_belt_check(actor, powered)
    local st = normalize_state()

    -- Собираем предметы, которые сейчас лежат на поясе (максимум 5).
    local on_belt = {}
    local count = actor:belt_count()
    if count then
        for i = 0, count - 1 do
            local item = actor:item_on_belt(i)
            if item then on_belt[item:id()] = item end
        end
    end

    local changes = 0
    local factor = powered and belt_factor() or 0

    -- 1. Пояс: гасим вклад артефактов, если аккумулятора нет, или отдаём его
    --    ослабленным по заряду (belt_factor), если аккумулятор есть.
    for id, item in pairs(on_belt) do
        local section = item:section()
        if is_artefact(section) then
            if powered then
                local real = saved_condition(id)
                if real ~= nil and real > 0 then
                    local target = real * factor
                    if get_condition(item) ~= target then
                        set_condition(item, target)
                        dbg(string.format("быстро обновил вклад %s (id=%d): %.3f -> %.3f",
                            section, id, real, target))
                    end
                    if factor >= 0.999 then
                        forget_condition(id)
                    else
                        remember_condition(id, real)
                    end
                    changes = changes + 1
                end
            else
                local current = get_condition(item)
                if current and current > 0 then
                    -- Настоящее значение берём из записи, если она есть: текущее
                    -- могло быть уже ослаблено зарядом.
                    local real = saved_condition(id) or current
                    remember_condition(id, real)
                    set_condition(item, 0)
                    changes = changes + 1
                    dbg(string.format("быстро спрятал состояние %s (id=%d), было %.3f", section, id, real))
                end
            end
        end
    end

    -- 2. Всё, что мы спрятали, но чего больше нет на поясе: сняли в рюкзак,
    --    выбросили, отдали. Возвращаем состояние сразу, чтобы предмет не остался
    --    «пустым» (и чтобы в окне торговли не было нулевой прочности).
    --    Удалять ключ во время pairs можно: стирается текущий ключ.
    for id, real in pairs(st.hidden) do
        if not on_belt[id] then
            local object = level.object_by_id(id)          -- клиентский объект, если он онлайн
            if object then
                if get_condition(object) ~= real then set_condition(object, real) end
                forget_condition(id)
                changes = changes + 1
                dbg(string.format("вернул состояние снятому предмету id=%d = %.3f", id, real))
            elseif not (alife() and alife():object(id)) then
                -- Объекта больше нет (например, артефакт вложили в контейнер и
                -- вместо него создали комбо) - запись просто убираем.
                forget_condition(id)
            end
            -- Если объект существует, но в офлайне, запись оставляем: состояние
            -- вернётся, когда предмет снова попадёт в инвентарь актора.
        end
    end

    return changes
end

----------------------------------------------------------------------------
-- Турер: объект-ограничитель со своим биндером (кадровый источник).
----------------------------------------------------------------------------
local function tuner_object()
    local id = _G.bq_battery.tuner_id
    if not id then return nil end
    local object = alife() and alife():object(id)
    if not object or object:section_name() ~= TUNER_SECTION then return nil end
    return object
end

local function ensure_tuner()
    local actor = db.actor
    if not actor or not alife() then return end
    if tuner_object() then return end

    local ok, err = pcall(function()
        local created = alife():create(TUNER_SECTION, actor:position(),
            actor:level_vertex_id(), actor:game_vertex_id())
        if created then
            local st = normalize_state()
            st.tuner_id  = created.id
            st.next_tick = time_global() + PERIOD_MS
            dbg("==== турер аккумулятора создан, id=" .. tostring(created.id) .. " ====")
        else
            dbg("ОШИБКА: турер не создался")
        end
    end)
    if not ok then
        dbg("ОШИБКА при создании турера: " .. tostring(err))
    end
end

class "bq_battery_tuner_binder" (object_binder)

function bq_battery_tuner_binder:__init(obj)
    super(obj)
end

function bq_battery_tuner_binder:net_spawn(server_object)
    if not object_binder.net_spawn(self, server_object) then
        return false
    end
    local st = normalize_state()
    st.tuner_id  = self.object:id()
    st.next_tick = time_global() + PERIOD_MS
    dbg("==== турер аккумулятора появился, id=" .. tostring(self.object:id()) .. " ====")
    return true
end

function bq_battery_tuner_binder:net_destroy()
    if _G.bq_battery.tuner_id == self.object:id() then
        _G.bq_battery.tuner_id = nil
    end
    dbg("турер аккумулятора уничтожен")
    object_binder.net_destroy(self)
end

----------------------------------------------------------------------------
-- ОБЩАЯ КАДРОВАЯ ЧАСТЬ.
--
-- Её зовут ДВА источника, и оба могут работать одновременно:
--   1) update биндера турера - механизм планировщика (основной);
--   2) штатная рассылка update, на которую мы подписываемся в on_game_start
--      (резервный; лог заказчика 09.10.2026 показал, что в этой сборке она
--      работает и переживает загрузку сейва).
--
-- ПОЧЕМУ ОДНА ФУНКЦИЯ, А НЕ ДВЕ КОПИИ. Раньше у каждого источника был свой
-- обработчик, и они делили один таймер next_tick: тот, кто срабатывал первым,
-- съедал окно, а второй почти всегда выходил по throttle. В логе заказчика из-за
-- этого пропали строки «ПОЯС ...» и диагностика (их писала только ветка биндера).
-- Теперь оба источника зовут tick(), который:
--   * КАЖДЫЙ вызов делает быструю проверку пояса (<= 5 предметов) - она
--     идемпотентна, повторный вызов в том же кадре ничего не делает;
--   * раз в PERIOD_MS (300 мс) делает полный проход и пишет лог.
----------------------------------------------------------------------------
-- МЕХАНИКА РАЗРЯДА И ВЫПАДЕНИЯ (пункт 4-5): см. константы DISCHARGE_SECTION и
-- DROP_SECTION выше (они объявлены до cfg_float/discharge_mult).

-- Игровое время в СЕКУНДАХ. В API есть только дни/часы/минуты (level_script.cpp
-- 1539-1541, get_time_seconds не зарегистрирован), поэтому секунды идут шагом
-- игровой минуты. Этого мало для тика раз в секунду, поэтому ниже берём ещё и
-- реальное время - см. discharge_step.
local function game_seconds()
    return ((level.get_time_days() * 24 + level.get_time_hours()) * 60 + level.get_time_minutes()) * 60
end

-- Разряд аккумулятора, который лежит в своём слоте. Вне слота (рюкзак, земля,
-- чужой инвентарь) заряд НЕ меняется - мы просто не трогаем такие предметы.
local function discharge_step(actor, battery)
    local st = normalize_state()
    local gnow = game_seconds()
    local rnow = time_global() / 1000
    if st.game_seconds == nil or st.real_seconds == nil then
        -- первый тик после старта или загрузки: запоминаем время, не разряжаем
        st.game_seconds = gnow
        st.real_seconds = rnow
        return
    end
    local dg = gnow - st.game_seconds
    local dr = rnow - st.real_seconds
    st.game_seconds = gnow
    st.real_seconds = rnow

    -- Отрицательный шаг - переход на другую локацию или откат часов, пропускаем.
    if dg < 0 then dg = 0 end
    if dr < 0 then dr = 0 end

    -- Берём БОЛЬШИЙ из двух шагов:
    --   * игровой больше - значит шло игровое время (сон, переход, time_factor);
    --   * реальный больше - игровые часы стоят или идут минутными шагами,
    --     тогда считаем по реальному времени, иначе механика «не разряжается».
    local delta = dg > dr and dg or dr
    if delta <= 0 then return end

    local days = cfg_float(battery:section(), "discharge_days", 0)
    if days <= 0 then return end

    -- считаем артефакты на поясе (наши комбо-контейнеры тоже class = ARTEFACT)
    local count = 0
    local belt = actor:belt_count() or 0
    for i = 0, belt - 1 do
        local item = actor:item_on_belt(i)
        if item and is_artefact(item:section()) then count = count + 1 end
    end

    local charge = get_condition(battery) or 1.0
    local drain = (delta / (days * 86400)) * discharge_mult(count)
    local new_charge = charge - drain
    if new_charge < 0 then new_charge = 0 end
    if new_charge ~= charge then
        set_condition(battery, new_charge)
        -- Пишем в лог раз в 10 секунд, чтобы разряд было видно и в игре, и в
        -- bq_battery.log (заказчик проверяет именно так).
        local now = time_global()
        if now >= (st.discharge_log or 0) + 10000 then
            st.discharge_log = now
            dbg(string.format("%s: заряд %.1f%% -> %.1f%% (шаг %.0f с, множитель %.2f, артефактов %d)",
                battery:section(), charge * 100, new_charge * 100, delta,
                discharge_mult(count), count))
        end
        if new_charge == 0 then
            dbg(string.format("аккумулятор %s полностью разряжен (артефактов на поясе: %d)",
                battery:section(), count))
            play_alarm()
        end
    end
end

-- Состояние (заряд) предмету, который только что создан В ИНВЕНТАРЕ трупа,
-- ставим, когда появится его клиентский объект: alife():create с родителем
-- создаёт серверный объект, а клиентский появляется следующим кадром/проходом.
local function apply_pending_conditions(st)
    if not st.drop_pending then return end
    for item_id, cond in pairs(st.drop_pending) do
        local client = level.object_by_id(item_id)
        if client then
            pcall(function() client:set_condition(cond) end)
            st.drop_pending[item_id] = nil
            dbg(string.format("заряд выпавшему аккумулятору id=%d выставлен: %.0f%%", item_id, cond * 100))
        end
    end
end

-- Выпадение аккумулятора из трупа человека. Движок не даёт колбэка смерти
-- (проверены все ключи LoadCallbackGlobals), поэтому раз в period_ms смотрим
-- объекты рядом (nearest.set/size/get - уровень) и ловим переход "жив -> мёртв".
-- Достаём предмет трупу через перегрузку alife():create с родителем (см. ниже).
local function drop_step(actor)
    local st = normalize_state()

    -- Сначала доводим заряд до предметов, выданных в прошлые проходы (их
    -- клиентский объект появляется не сразу после alife():create).
    apply_pending_conditions(st)

    local now = time_global()
    local period = cfg_float(DROP_SECTION, "period_ms", 1000)
    if now < (st.drop_next or 0) then return end
    st.drop_next = now + period

    local radius = cfg_float(DROP_SECTION, "radius", 60)
    local cmin = cfg_float(DROP_SECTION, "condition_min", 0.0)
    local cmax = cfg_float(DROP_SECTION, "condition_max", 1.0)
    local communities = ""
    pcall(function()
        local ini = system_ini()
        if ini:section_exist(DROP_SECTION) and ini:line_exist(DROP_SECTION, "communities") then
            communities = ini:r_string(DROP_SECTION, "communities")
        end
    end)

    if not st.drop_seen then st.drop_seen = {} end

    local ok = pcall(function()
        nearest.set(radius, actor:position())
        local n = nearest.size()
        for i = 0, n - 1 do
            local obj = nearest.get(i)
            if obj and obj:id() then
                local id = obj:id()
                local seen = st.drop_seen[id]
                local dead = not obj:alive()
                if not seen then
                    st.drop_seen[id] = dead and "dead" or "alive"
                end
                -- Труп, который мы видим ВПЕРВЫЕ (NPC заспавнили и сразу убили, или
                -- тело вошло в радиус позже), обрабатываем как смерть. Иначе такие
                -- NPC не получали аккумулятор вообще: заказчик заспавнил 20
                -- сталкеров и не увидел ни одного выпадения.
                if seen == nil and dead then seen = "alive" end
                if seen == "alive" and dead then
                    st.drop_seen[id] = "dead"
                    -- проверяем сообщество: только люди из списка
                    local community = nil
                    pcall(function() community = obj:character_community() end)
                    -- Диагностика для проверки заказчика: видно КАЖДЫЙ труп и его
                    -- сообщество, поэтому сразу понятно, почему нет выпадения.
                    dbg(string.format("труп id=%d: сообщество '%s'%s", id, tostring(community),
                        (community and communities ~= "" and string.find(communities, community, 1, true))
                            and " - в списке, бросаю шанс" or " - НЕ в списке, пропускаю"))
                    if community and communities ~= "" and string.find(communities, community, 1, true) then
                        for section, chance in pairs({
                            bq_battery_1 = cfg_float(DROP_SECTION, "chance_bq_battery_1", 0),
                            bq_battery_2 = cfg_float(DROP_SECTION, "chance_bq_battery_2", 0),
                            bq_battery_3 = cfg_float(DROP_SECTION, "chance_bq_battery_3", 0),
                        }) do
                            if math.random() < chance then
                                -- Кладём предмет СРАЗУ В ИНВЕНТАРЬ ТРУПА: у alife():create
                                -- есть перегрузка с id родителя (CALifeSimulator__spawn_item2,
                                -- alife_simulator_script.cpp:496). Так делают и скрипты
                                -- движка: alife():create(v, pos, lv_id, gv_id, npc_id)
                                -- (xr_effects.script:453). Раньше мы спавнили предмет на
                                -- землю и звали transfer_item - он создаёт события
                                -- SELL/BUY, но предмет с земли в труп не перекладывает,
                                -- поэтому заказчик и находил аккумулятор на земле.
                                local item = alife():create(section, obj:position(),
                                    obj:level_vertex_id(), obj:game_vertex_id(), id)
                                if item then
                                    local cond = cmin + math.random() * (cmax - cmin)
                                    st.drop_pending = st.drop_pending or {}
                                    st.drop_pending[item.id] = cond
                                    dbg(string.format("в трупе id=%d оказался %s (заряд будет %.0f%%)",
                                        id, section, cond * 100))
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    end)
    if not ok then dbg("ОШИБКА в drop_step") end
end

local function tick()
    local actor = db.actor
    if not actor then return end

    local st  = normalize_state()
    local now = time_global()

    -- Турер нужен как кадровый источник: создаём его при первой же возможности
    -- (актор уже есть), чтобы не ждать первого действия игрока.
    if not st.tuner_id then ensure_tuner() end

    -- 1. КАЖДЫЙ ВЫЗОВ: быстрая проверка пояса (см. fast_belt_check). Именно она
    -- убирает «скачок статов»: артефакт, положенный на пояс без аккумулятора,
    -- гасится в том же кадре, до следующего пересчёта пояса движком (100 мс).
    local ok_fast, err_fast = pcall(function()
        fast_belt_check(actor, battery_in_slot(actor))
    end)
    if not ok_fast and now >= (st.last_error or 0) + 1000 then
        st.last_error = now
        dbg("ОШИБКА в быстрой проверке пояса: " .. tostring(err_fast))
    end

    -- 2. Раз в PERIOD_MS: полный проход по инвентарю (возврат состояния
    -- предметам не на поясе, выброшенные предметы, диагностика).
    if now < (st.next_tick or 0) then return end
    st.next_tick = now + PERIOD_MS
    st.cycles = st.cycles + 1

    local ok, err = pcall(function()
        local powered, section = battery_in_slot(actor)

        -- Сообщаем об изменении состояния пояса сразу (важно для проверки в игре).
        if st.powered ~= powered then
            st.powered = powered
            dbg(string.format("ПОЯС %s (в слоте %d: %s)",
                powered and "ВКЛЮЧЁН" or "ВЫКЛЮЧЕН", BATTERY_SLOT,
                section or "пусто"))
        end

        local stats, seen = apply_gate(actor, powered)
        restore_orphans(seen)

        -- Пункт 4-5: разряд аккумулятора в слоте и выпадение из трупов.
        local slot_item = actor:item_in_slot(BATTERY_SLOT)
        if slot_item and is_battery(slot_item:section()) then
            local ok_d, err_d = pcall(function() discharge_step(actor, slot_item) end)
            if not ok_d then dbg("ОШИБКА в разряде: " .. tostring(err_d)) end
        else
            local st_reset = normalize_state()
            st_reset.game_seconds = game_seconds()
            st_reset.real_seconds = time_global() / 1000
        end
        local ok_drop, err_drop = pcall(function() drop_step(actor) end)
        if not ok_drop then dbg("ОШИБКА в выпадении: " .. tostring(err_drop)) end

        -- Полоски состояния в открытом окне: без этого заряд в интерфейсе виден
        -- только после переоткрытия инвентаря (см. refresh_ui).
        refresh_ui()

        -- Диагностика раз в 5 секунд.
        if now >= (st.last_status or 0) + 5000 then
            st.last_status = now
            dbg(string.format("цикл=%d пояс=%s | артефактов=%d на поясе=%d спрятано=%d возвращено=%d (в памяти %d)",
                st.cycles, powered and "вкл" or "выкл", stats.artefacts, stats.belt,
                stats.hidden, stats.restored, (function()
                    local n = 0
                    for _ in pairs(st.hidden) do n = n + 1 end
                    return n
                end)()))
        end
    end)

    if not ok and now >= (st.last_error or 0) + 1000 then
        st.last_error = now
        dbg("ОШИБКА в кадровом обработчике: " .. tostring(err))
    end
end

-- Кадровый обработчик биндера турера (основной источник).
function bq_battery_tuner_binder:update(delta)
    object_binder.update(self, delta)
    tick()
end

function bind(obj)
    obj:bind_object(bq_battery_tuner_binder(obj))
end

----------------------------------------------------------------------------
-- Точки входа.
----------------------------------------------------------------------------
-- Главная: движок зовёт её сам (ключ start_game_callback в [alife],
-- alife_simulator.cpp:81-84) при старте новой игры и при загрузке сохранения.
-- Вызывается ДО загрузки уровня, поэтому актора ещё нет: здесь только
-- переподписываемся и помечаем, что механику надо поднять.
-- ОБЯЗАТЕЛЬНО вызываем ванильную функцию - её тоже ждёт движок.
function on_game_start()
    local vanilla = _G.start_game_callback
    if type(vanilla) == "function" and vanilla ~= on_game_start then
        local ok, err = pcall(vanilla)
        if not ok then dbg("ОШИБКА в ванильном start_game_callback: " .. tostring(err)) end
    end

    normalize_state()
    _G.bq_battery.hidden = _G.bq_battery.hidden or {}

    -- Резервный кадровый источник: штатная рассылка update. В этой сборке она
    -- может потеряться (MEMO 31.3), поэтому это именно резерв, а основной -
    -- биндер турера.
    pcall(function()
        if type(RegisterScriptCallback) == "function" then
            RegisterScriptCallback("update", bq_battery_update)
        end
    end)

    dbg("==== механика аккумулятора загружена (on_game_start) ====")
end

-- Резервный кадровый источник: штатная рассылка update. Лог заказчика от
-- 09.10.2026 показал, что в этой сборке она работает и переживает загрузку
-- сейва (механика отработала именно через неё), поэтому оставляем её как
-- полноценный второй источник, а не как «аварийный»: оба зовут одну tick()
-- (см. пояснение выше) - двойной вызов ничего не ломает.
function bq_battery_update(delta)
    tick()
end

-- Резервные точки загрузки из [callbacks] (mod_game_global_z_bq.ltx).
-- Здесь НЕЛЬЗЯ делать тяжёлую работу: повторный вход в Lua из C++ внутри уже
-- исполняющегося Lua-колбэка валит игру (проверено в MEMO 33.7/сеансе 21).
-- Возврат true безопасен для всех трёх ключей:
--   OnItemFocusLost - результат игнорируется;
--   OnZoneTouch     - false глушит звук детектора зоны;
--   OnBeforeHit     - false отменяет попадание по актору.
function on_load_trigger(...)
    ensure_tuner()
    return true
end

-- Если файл исполнился по другому поводу - тоже позаботимся о турере.
ensure_tuner()
