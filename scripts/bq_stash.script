local STASH_POS = { x = 224.6, y = 9.5, z = -36 }

local STASH_ITEMS = {
    { "bq_documents", 1 },
    { "bread", 2 },
    { "medkit", 1 },
    { "ammo_9x18_fmj", 32 },
}

local SPAWNED_INFO = "bq_stash_spawned"

function spawn_stash()
    if has_alife_info(SPAWNED_INFO) then
        return nil
    end

    local pos = vector():set(STASH_POS.x, STASH_POS.y, STASH_POS.z)

    local lv_id = level.vertex_id(pos)
    local gv_id = db.actor:game_vertex_id()

    local box = alife():create(
        "bq_stash_box",
        pos,
        lv_id,
        gv_id
    )

    if not box then
        printf("[bq] ERROR: failed to spawn stash box")
        return nil
    end

    for i = 1, #STASH_ITEMS do
        local item_section = STASH_ITEMS[i][1]
        local item_count = STASH_ITEMS[i][2]

        if item_section == "ammo_9x18_fmj" then
            alife():create_ammo(
                item_section,
                vector(),
                0,
                0,
                box.id,
                item_count
            )
        else
            for j = 1, item_count do
                alife():create(
                    item_section,
                    vector(),
                    0,
                    0,
                    box.id
                )
            end
        end
    end

    db.actor:give_info_portion(SPAWNED_INFO)

    printf(
        "[bq] stash box spawned (id %s)",
        tostring(box.id)
    )

    return box.id
end