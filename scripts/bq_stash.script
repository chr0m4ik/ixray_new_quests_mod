local STASH_POS = { x = 224.6, y = 9.5, z = -36 }
local ITEMS = { { "bq_documents", 1 }, { "bread", 2 }, { "medkit", 1 } }

function spawn_stash()
    if not bq_state.is_zaton() then return nil end
    local box = bq_state.find("bq_stash_box", "stash_id")
    if box and has_alife_info("bq_stash_spawned") then return box.id end
    -- A missing previously looted box must not duplicate quest items.
    if has_alife_info("bq_stash_spawned") then return nil end
    box = box or bq_state.spawn("bq_stash_box", "stash_id", STASH_POS)
    if not box then return nil end
    for _, item in ipairs(ITEMS) do
        for count = 1, item[2] do
            alife():create(item[1], box.position, box.m_level_vertex_id, box.m_game_vertex_id, box.id)
        end
    end
    alife():create_ammo("ammo_9x18_fmj", box.position, box.m_level_vertex_id, box.m_game_vertex_id, box.id, 32)
    db.actor:give_info_portion("bq_stash_spawned")
    return box.id
end
