local function get_npc(first_speaker, second_speaker)
    local npc = second_speaker
    if db.actor and npc and db.actor:id() == npc:id() then
        npc = first_speaker
    end
    if not npc or not db.actor or npc:id() == db.actor:id() then
        return nil
    end
    return npc
end

-- Сделать Хмурого врагом

function set_enemy(first_speaker, second_speaker)
    local npc = get_npc(first_speaker, second_speaker)
    if not npc then
        printf("bq_hmury.set_enemy: ERROR — cannot detect NPC")
        return
    end

    printf("bq_hmury.set_enemy: making [%s] enemy to actor", npc:name())
    npc:force_set_goodwill(-1000, db.actor)
    npc:set_relation(game_object.enemy, db.actor)

    local st = db.storage[npc:id()]
    if st and st.meet then
        st.meet.enabled = false
    end

    xr_motivator.update_logic(npc)
    if xr_meet and xr_meet.process_npc_usability then
        xr_meet.process_npc_usability(npc)
    end
end

-- Передать документы Хмурому за 2000
function give_docs_2000(first_speaker, second_speaker)
    local npc = get_npc(first_speaker, second_speaker)
    if not npc then
        printf("bq_hmury.give_docs_2000: ERROR — cannot detect NPC")
        return
    end

    local item = db.actor:object("bq_documents")
    if not item then
        printf("bq_hmury.give_docs_2000: WARNING — actor has no bq_documents")
        return
    end

    local alife_item = alife():object(item:id())
    if alife_item then
        pcall(function() alife():release(alife_item, true) end)
    end

    db.actor:give_info_portion("bq_docs_given_to_hmury")

    pcall(function()
        dialogs.relocate_money_to_actor(first_speaker, second_speaker, 2000)
    end)

    printf("bq_hmury.give_docs_2000: docs released, 2000 paid")
end

-- Передать документы Хмурому за 2000 + бронежилет
function give_docs_2000_armor(first_speaker, second_speaker)
    local npc = get_npc(first_speaker, second_speaker)
    if not npc then
        printf("bq_hmury.give_docs_2000_armor: ERROR — cannot detect NPC")
        return
    end

    local item = db.actor:object("bq_documents")
    if not item then
        printf("bq_hmury.give_docs_2000_armor: WARNING — actor has no bq_documents")
        return
    end

    local alife_item = alife():object(item:id())
    if alife_item then
        pcall(function() alife():release(alife_item, true) end)
    end

    -- Сначала отмечаем факт передачи — это критично для спавна доков на трупе
    db.actor:give_info_portion("bq_docs_given_to_hmury")

    -- Деньги
    pcall(function()
        dialogs.relocate_money_to_actor(first_speaker, second_speaker, 2000)
    end)

    -- Броник (проверь название секции в outfit.ltx!)
    pcall(function()
        dialogs.relocate_item_section_to_actor(
            first_speaker, second_speaker, "bandit_outfit", 1)
    end)

    printf("bq_hmury.give_docs_2000_armor: docs released, 2000 + armor paid")
end

-- Кенты Хмурого становятся врагами
function set_enemy_all(first_speaker, second_speaker)
    set_enemy(first_speaker, second_speaker)

    local ids = {
        bq_quest and bq_quest.bq_hmury_guard_1_id or nil,
        bq_quest and bq_quest.bq_hmury_guard_2_id or nil
    }

    for _, id in ipairs(ids) do
        if id then
            local se_obj = alife():object(id)
            if se_obj then
                pcall(function()
                    se_obj:force_set_goodwill(-1000, db.actor:id())
                end)
            end

            local cl = level.object_by_id(id)
            if cl then
                pcall(function()
                    cl:set_relation(game_object.enemy, db.actor)
                end)
                pcall(function()
                    xr_motivator.update_logic(cl)
                end)
            end

            printf("bq_hmury.set_enemy_all: guard %s -> enemy", tostring(id))
        end
    end
end