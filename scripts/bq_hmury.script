local function make_enemy(npc)
    if not npc or not npc:alive() then return end
    npc:force_set_goodwill(-1000, db.actor)
    npc:set_relation(game_object.enemy, db.actor)
    npc:disable_talk()
end

function apply_hostility()
    if not bq_state.is_zaton() or not has_alife_info("bq_hmury_hostile") then return end
    for _, spec in ipairs(bq_quest.squad_sections()) do
        local object = bq_state.find(spec.section, spec.key)
        if object then make_enemy(level.object_by_id(object.id)) end
    end
end

function set_enemy(first_speaker, second_speaker)
    if not bq_state.ready() then return end
    db.actor:give_info_portion("bq_hmury_hostile")
    db.actor:disable_info_portion("bq_hmury_dialog_ready")
    make_enemy(bq_state.npc(first_speaker, second_speaker))
end

function set_enemy_all(first_speaker, second_speaker)
    set_enemy(first_speaker, second_speaker)
    apply_hostility()
end

local function give_documents(first_speaker, second_speaker, with_armor)
    if not bq_state.ready() or bq_quest.is_finished() then return end
    if has_alife_info("bq_docs_given_to_hmury") then return end
    local npc = bq_state.npc(first_speaker, second_speaker)
    if not npc or not npc:alive() or not bq_quest.has_documents() then return end
    -- The transferred item remains in the NPC inventory and can be looted later.
    local item = db.actor:object("bq_documents")
    bq_state.store("documents_id", item:id())
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "bq_documents", 1)
    db.actor:give_info_portion("bq_docs_given_to_hmury")
    db.actor:disable_info_portion("bq_hmury_dialog_ready")
    dialogs.relocate_money_to_actor(first_speaker, second_speaker, 2000)
    if with_armor then
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "stalker_outfit", 1)
    end
end

function give_docs_2000(first_speaker, second_speaker)
    give_documents(first_speaker, second_speaker, false)
end

function give_docs_2000_armor(first_speaker, second_speaker)
    give_documents(first_speaker, second_speaker, true)
end
