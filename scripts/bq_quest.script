local TASK_STASH = "bq_beard_task"
local TASK_DELIVER = "bq_deliver_task"
local TASK_BUYER = "bq_buyer_task"
local TASK_SELL = "bq_sell_sich_task"
local SQUAD = {
    { section = "bq_zaton_stalker_hmury", key = "hmury_id", position = { x = 227, y = 9.5, z = -27.5 } },
    { section = "bq_zaton_hmury_guard_1", key = "guard_1_id", position = { x = 220, y = 9.5, z = -27 } },
    { section = "bq_zaton_hmury_guard_2", key = "guard_2_id", position = { x = 230, y = 9.5, z = -15 } }
}
local callback_backend = nil
local loaded = false
local next_update = 0

function squad_sections()
    return SQUAD
end

function is_finished()
    return bq_state.ready() and (has_alife_info("bq_docs_delivered") or has_alife_info("bq_docs_sold"))
end

function has_documents()
    on_game_start()
    return bq_state.ready() and db.actor:object("bq_documents") ~= nil
end

function can_start()
    on_game_start()
    return bq_state.is_zaton() and not has_alife_info("bq_quest_started")
end

local function set_task_state(id, state)
    if db.actor:get_task(id, true) then db.actor:set_task_state(state, id, 0) end
end

local function give_task_once(id, title, description, priority, target)
    if db.actor:get_task(id, false) then return end
    local objective = CGameTask()
    objective:set_id(id)
    objective:set_type(task.additional)
    objective:set_title(game.translate_string(title))
    objective:set_description(game.translate_string(description))
    objective:set_priority(priority)
    objective:set_icon_name("ui_inGame2_Sdelka")
    objective:add_complete_func("bq_quest.poll_task")
    if target and alife():object(target) then
        objective:set_map_location("secondary_task_location")
        objective:set_map_object_id(target)
    end
    db.actor:give_task(objective, 0, true, 0)
end

local function beard_id()
    local id = bq_state.story_id("zat_a2_stalker_barmen") or bq_state.retrieve("beard_id", false)
    return id and alife():object(id) and id or nil
end

local function ensure_tasks()
    if is_finished() or not has_alife_info("bq_quest_started") then return end
    if not has_alife_info("bq_documents_taken") then
        local stash = bq_state.find("bq_stash_box", "stash_id")
        give_task_once(TASK_STASH, "bq_task_name", "bq_task_descr", 2, stash and stash.id)
        return
    end
    set_task_state(TASK_STASH, task.completed)
    give_task_once(TASK_DELIVER, "bq_deliver_name", "bq_deliver_descr", 3, beard_id())
    if has_alife_info("bq_sich_hint_given") then
        set_task_state(TASK_BUYER, task.completed)
        give_task_once(TASK_SELL, "bq_sell_to_sich_name", "bq_sell_to_sich_descr", 4,
            bq_state.story_id("zat_b30_owl_stalker_trader"))
    else
        give_task_once(TASK_BUYER, "bq_buyer_name", "bq_buyer_descr", 4,
            bq_state.story_id("zat_b215_stalker_guide"))
    end
end

local function spawn_squad()
    if not bq_state.is_zaton() or is_finished() then return end
    local all_spawned = true
    for _, spec in ipairs(SQUAD) do
        local object = bq_state.find(spec.section, spec.key)
        if object or has_alife_info("bq_hmury_spawned") then
            bq_state.store(spec.key .. "_spawned", true)
        end
        -- A dead or released member must not be spawned for a second time.
        if not object and not bq_state.retrieve(spec.key .. "_spawned", false) then
            object = bq_state.spawn(spec.section, spec.key, spec.position)
        end
        if object then bq_state.store(spec.key .. "_spawned", true) end
        all_spawned = all_spawned and bq_state.retrieve(spec.key .. "_spawned", false)
    end
    if all_spawned then db.actor:give_info_portion("bq_hmury_spawned") end
    if not has_alife_info("bq_docs_given_to_hmury") and not has_alife_info("bq_hmury_hostile") then
        db.actor:give_info_portion("bq_hmury_dialog_ready")
    end
end

function give_task(first_speaker, second_speaker)
    if not bq_state.is_zaton() or is_finished() then return end
    if has_alife_info("bq_quest_started") then ensure_tasks() return end
    local stash = bq_stash.spawn_stash()
    if not stash then
        printf("[bq] Quest start postponed: stash could not be created")
        return
    end
    local npc = bq_state.npc(first_speaker, second_speaker)
    if npc then bq_state.store("beard_id", npc:id()) end
    db.actor:give_info_portion("bq_quest_started")
    ensure_tasks()
end

function on_documents_taken()
    if not has_documents() or is_finished() or not has_alife_info("bq_quest_started") then return end
    if not has_alife_info("bq_documents_taken") then
        db.actor:give_info_portion("bq_documents_taken")
        db.actor:give_info_portion("bq_deliver_task")
        db.actor:give_info_portion("bq_buyer_task")
    end
    spawn_squad()
    ensure_tasks()
end

function try_check_documents()
    if not bq_state.ready() or is_finished() or not has_alife_info("bq_quest_started") then return false end
    if has_alife_info("bq_documents_taken") or not has_documents() then return false end
    on_documents_taken()
    return true
end

local function finish(first_speaker, second_speaker, sold)
    if not has_documents() or is_finished() then return false end
    local npc = bq_state.npc(first_speaker, second_speaker)
    if not npc then return false end
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "bq_documents", 1)
    db.actor:give_info_portion(sold and "bq_docs_sold" or "bq_docs_delivered")
    db.actor:give_info_portion(sold and "bq_beard_angry" or "bq_beard_grateful")
    db.actor:disable_info_portion("bq_hmury_dialog_ready")
    dialogs.relocate_money_to_actor(first_speaker, second_speaker, sold and 5000 or 2000)
    if not sold then
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "wpn_colt1911", 1)
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "ammo_11.43x23_fmj", 3)
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "medkit", 3)
        dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "bandage", 4)
    end
    for _, id in ipairs({ TASK_STASH, TASK_DELIVER, TASK_BUYER, TASK_SELL }) do set_task_state(id, task.completed) end
    -- Release live quest NPCs only after the actor has left the dialog.
    db.actor:give_info_portion("bq_cleanup_pending")
    bq_stash_quest.start()
    return true
end

function on_documents_delivered(first_speaker, second_speaker)
    finish(first_speaker, second_speaker, false)
end

function on_documents_sold(first_speaker, second_speaker)
    finish(first_speaker, second_speaker, true)
end

function on_sich_hint_given()
    if not bq_state.ready() or is_finished() or not has_alife_info("bq_documents_taken") then return end
    db.actor:give_info_portion("bq_sich_hint_given")
    ensure_tasks()
end

local function recover_legacy_documents()
    if not has_alife_info("bq_docs_given_to_hmury") or has_alife_info("bq_docs_recovered") or is_finished() then return end
    if has_documents() then db.actor:give_info_portion("bq_docs_recovered") return end
    local hmury = bq_state.find(SQUAD[1].section, SQUAD[1].key)
    if not hmury or hmury:alive() then return end
    local document_id = bq_state.retrieve("documents_id", false)
    local document = document_id and alife():object(document_id)
    if document and document:section_name() == "bq_documents" then
        db.actor:give_info_portion("bq_docs_recovered")
        return
    end
    local client = level.object_by_id(hmury.id)
    -- Repair documents deleted by older addon versions, without duplicating transferred items.
    local found = client and client:object("bq_documents")
    if not found then
        for id = 0, 65534 do
            local item = alife():object(id)
            if item and item.parent_id == hmury.id and item:section_name() == "bq_documents" then
                found = item
                break
            end
        end
    end
    if not found then
        found = alife():create("bq_documents", hmury.position, hmury.m_level_vertex_id, hmury.m_game_vertex_id, hmury.id)
    end
    if found then db.actor:give_info_portion("bq_docs_recovered") end
end

local function cleanup()
    if not has_alife_info("bq_cleanup_pending") or db.actor:is_talking() then return end
    for _, spec in ipairs(SQUAD) do
        local object = bq_state.find(spec.section, spec.key)
        if object and object:alive() then bq_state.release(spec.section, spec.key) end
    end
    bq_state.release("bq_beard_marker", "beard_marker")
    bq_state.release("bq_sich_marker", "sich_marker")
    db.actor:disable_info_portion("bq_cleanup_pending")
end

function on_game_load()
    loaded = false
    next_update = 0
    bq_state.reset()
end

function update()
    if not bq_state.ready() then return end
    if not loaded then
        loaded = true
        if has_alife_info("bq_documents_taken") and not is_finished() then spawn_squad() end
        ensure_tasks()
        if is_finished() then db.actor:give_info_portion("bq_cleanup_pending") end
    end
    local now = time_global()
    if now < next_update then return end
    next_update = now + 500
    try_check_documents()
    if has_alife_info("bq_documents_taken") and not is_finished() then
        -- Resume postponed spawning when the actor returns to Zaton.
        spawn_squad()
        if bq_state.is_zaton() then
            bq_hmury.apply_hostility()
            recover_legacy_documents()
        end
    end
    cleanup()
end

function on_game_start()
    -- Both older IX-Ray and the current framework dispatch these legacy event names.
    local backend = (ixr_framework and ixr_framework.is_module_loaded("ixr_signals")) and ixr_framework or _G
    if callback_backend == backend then return end
    RegisterScriptCallback("update", update)
    RegisterScriptCallback("load", on_game_load)
    callback_backend = backend
    printf("[bq] Quest callbacks initialized")
end

function poll_task()
    -- Serialized task functors reload this module after a Lua VM restart.
    -- Returning false leaves completion to the explicit quest actions.
    on_game_start()
    return false
end

-- Older engines have no on_game_start autoloader; module loading initializes callbacks.
on_game_start()
