-- bq_inv_rad.script
-- Радиация от артефактов, лежащих В РЮКЗАКЕ (а не на поясе).
--
-- ЗАДАЧА: артефакт в рюкзаке облучает актора так же, как на поясе. Костюм не
-- учитывается. NPC, трупы, ящики, предметы на земле и в слотах не считаются -
-- только предметы у актора, КРОМЕ надетых на пояс (пояс считает движок).
--
-- ЭТАЛОН - пояс (чистый C++):
--   CActor::UpdateArtefactsOnBeltAndOutfit, Actor.cpp:2591-2641, вызывается из
--   CActor::shedule_Update (Actor.cpp:2013, вызов на :2236) раз в
--   ARTEFACTS_UPDATE_TIME = 0.100f (Actor.cpp:2589):
--
--       for (const PIItem item : inventory().m_belt)      // :2608 - ТОЛЬКО пояс
--           if (CArtefact* artefact = item->cast_artefact())
--           {
--               float art_cond = artefact->GetCondition();
--               if ((artefact->m_fRadiationRestoreSpeed * art_cond) > 0.0f)
--               {
--                   float val = (artefact->m_fRadiationRestoreSpeed * art_cond)
--                             - conditions().GetBoostRadiationImmunity();
--                   clamp(val, 0.0f, val);                // :2622 - ограничение СНИЗУ
--                   conditions().ChangeRadiation(val * f_update_time);
--               }
--               else
--                   conditions().ChangeRadiation((artefact->m_fRadiationRestoreSpeed * art_cond) * f_update_time);
--           }
--
--   Замечание про clamp: clamp(value, min, max) при min > max возвращает max,
--   то есть здесь это max(0, val) - ограничение СНИЗУ, а не сверху. Оно активно
--   только при boost > 0. boost_radiation_immunity из Lua НЕДОСТУПЕН (биндинга
--   нет), поэтому берём его минимальное значение 0 - тогда вклад пояса равен
--   radiation * condition без ограничений, и рюкзак считается ровно так же.
--
--   Износ (condition) для рюкзака НЕ учитываем: механики износа артефактов в
--   проекте сейчас нет (решение заказчика, 08.10.2026).
--
-- ЗАЧЕМ ОБЪЕКТ-ТУРЕР. Штатная рассылка RegisterScriptCallback("update", ...) в
-- этой сборке до наших обработчиков не доходит (проверено логами: обработчик
-- вызывается 1 раз и замолкает). Зато у обычного игрового объекта есть свой
-- Lua-биндер, и его метод update зовёт ПЛАНИРОВЩИК каждый кадр:
--   CGameObject::shedule_Update (GameObject.cpp:811-826)
--     -> CScriptBinder::shedule_Update (:825)
--       -> luabind::call_member<void>(this, "update", time_delta)
--          (script_binder_object_wrapper.cpp:84-87)
-- Именно на этом механизме держится и радиация пояса.
--
-- Поэтому в аддоне заведена секция [bq_rad_tuner]:space_restrictor со своим
-- script_binding = bq_inv_rad.bind (см. configs\misc\mod_artefacts_z_bq.ltx).
-- Турер - невидимый объект-ограничитель (класс SPC_RS_S, см. system.ltx:621),
-- он спавнится рядом с актором и удаляется при создании нового, чтобы не
-- копиться. При смене уровня объекты уничтожаются движком сами.
--
-- ОТЛАДКА: log() из скриптов аддона в игровой лог не попадает (MEMO 13.5),
-- поэтому пишем в bq_inv_rad.log в корне игры.

-- Отладочный лог. Включать только на время проверки в игре.
local DEBUG = true
local LOG_FILE = "bq_inv_rad.log"

-- Периодичность начисления, мс. Как у пояса: ARTEFACTS_UPDATE_TIME = 0.100f.
local PERIOD_MS = 100

-- Ограничение дельты времени, мс. После загрузки сейва или смены уровня метка
-- time_global() "рвётся", и без ограничения первый расчёт начислил бы огромную
-- дозу.
local MAX_DELTA_MS = 1000

-- Секция турера (см. configs\misc\mod_artefacts_z_bq.ltx).
local TUNER_SECTION = "bq_rad_tuner"

----------------------------------------------------------------------------
-- Отладка
----------------------------------------------------------------------------
local function dbg(msg)
    if not DEBUG then return end
    local f = io.open(LOG_FILE, "a")
    if f then
        f:write(os.date("%H:%M:%S") .. "  " .. msg .. "\n")
        f:close()
    end
end

----------------------------------------------------------------------------
-- Таблица радиации по секциям.
--
-- Кэш: section -> radiation_restore_speed.
--
-- ВАЖНО (проверено вылетом 08.10.2026): читать ключ можно ТОЛЬКО после проверки
-- line_exist. CScriptIniFile::r_float при отсутствии ключа делает VERIFY3
-- ("Cannot find line", script_ini_file.cpp:80-108), а VERIFY3 в этой сборке
-- приводит к Debug.fatal - то есть к МГНОВЕННОМУ завершению игры:
--
--   FATAL ERROR  CInifile::r_string  Xr_ini.cpp:612
--   Arguments    : Can't find variable radiation_restore_speed in [device_pda]
--
-- pcall такой вылет НЕ ловит: это не Lua-ошибка, а фатальный выход движка.
-- Поэтому порядок строго такой: section_exist -> line_exist -> r_float.
--
-- Берём значение из конфига, а НЕ через item:get_artefact_radiation(): тот
-- бросает исключение на не-артефакте и требует живого объекта, а конфиг
-- работает для любого предмета.
----------------------------------------------------------------------------
local rad_cache = {}

local function section_radiation(section)
    if not section then return 0 end
    local known = rad_cache[section]
    if known ~= nil then return known end

    local value = 0
    local ok, res = pcall(function()
        local ini = system_ini()
        -- section_exist и line_exist обязательны: без них r_float убьёт игру.
        if not ini:section_exist(section) then return 0 end
        if not ini:line_exist(section, "radiation_restore_speed") then return 0 end
        return ini:r_float(section, "radiation_restore_speed")
    end)
    if ok and type(res) == "number" and res > 0 then
        value = res
    end

    rad_cache[section] = value
    return value
end

----------------------------------------------------------------------------
-- Подсчёт суммы радиации по предметам актора, КРОМЕ надетых на пояс.
----------------------------------------------------------------------------
local function compute_sum(actor)
    local sum = 0
    local total = 0
    local artefacts = 0
    local belt = 0

    -- iterate_inventory перебирает inventory().m_all: рюкзак, пояс и слоты
    -- (script_game_object_inventory_owner.cpp:270-286). ВАЖНО: колбэк НЕ должен
    -- вернуть true - это немедленно оборвёт перебор (:276-279).
    actor:iterate_inventory(function(owner, item)
        if not item then return end
        total = total + 1

        local rad = section_radiation(item:section())
        if rad > 0 then
            artefacts = artefacts + 1
            -- Пояс обрабатывает движок (Actor.cpp:2608) - пропускаем, иначе
            -- получилось бы двойное начисление.
            if owner:is_on_belt(item) then
                belt = belt + 1
            else
                sum = sum + rad
            end
        end
    end, actor)

    return sum, total, artefacts, belt
end

----------------------------------------------------------------------------
-- Турер: поиск, спавн, удаление
----------------------------------------------------------------------------
-- Идентификатор текущего турера. Живёт в _G: модуль может исполниться повторно,
-- и тогда локальная переменная нового экземпляра была бы пустой.
_G.bq_inv_rad = _G.bq_inv_rad or {
    tuner_id = nil,        -- id турера на текущем уровне
    next_tick = nil,       -- время следующего начисления, мс
    accum_from = nil,      -- от какого момента копится время, мс
    cycles = 0,            -- сколько раз начислили (диагностика)
    last_log = 0,          -- время последней записи в лог, мс
}

local function tuner_object()
    local id = _G.bq_inv_rad.tuner_id
    if not id then return nil end
    local obj = alife() and alife():object(id)
    if not obj or obj:section_name() ~= TUNER_SECTION then return nil end
    return obj
end

-- Спавн турера рядом с актором. Старый удаляется, чтобы не копились.
local function ensure_tuner()
    local actor = db.actor
    if not actor or not alife() then return end

    if tuner_object() then return end           -- уже есть на этом уровне

    local position = actor:position()
    local lvid     = actor:level_vertex_id()
    local gvid     = actor:game_vertex_id()

    local ok, err = pcall(function()
        local created = alife():create(TUNER_SECTION, position, lvid, gvid)
        if created then
            local st = _G.bq_inv_rad
            st.tuner_id   = created.id
            st.accum_from = time_global()
            st.next_tick  = time_global() + PERIOD_MS
            dbg("турер создан, id=" .. tostring(created.id))
        else
            dbg("ОШИБКА: турер не создался")
        end
    end)
    if not ok then
        dbg("ОШИБКА при создании турера: " .. tostring(err))
    end
end

----------------------------------------------------------------------------
-- Биндер турера. Движок зовёт bind(obj) при появлении объекта, а затем
-- вызывает метод update каждый кадр (см. шапку файла).
----------------------------------------------------------------------------
class "bq_rad_tuner_binder" (object_binder)

function bq_rad_tuner_binder:__init(obj)
    super(obj)
end

function bq_rad_tuner_binder:net_spawn(server_object)
    if not object_binder.net_spawn(self, server_object) then
        return false
    end
    local st = _G.bq_inv_rad
    st.tuner_id   = self.object:id()
    st.accum_from = time_global()
    st.next_tick  = time_global() + PERIOD_MS
    dbg("==== турер радиации появился, id=" .. tostring(self.object:id()) .. " ====")
    return true
end

function bq_rad_tuner_binder:net_destroy()
    if _G.bq_inv_rad.tuner_id == self.object:id() then
        _G.bq_inv_rad.tuner_id = nil
    end
    dbg("турер радиации уничтожен")
    object_binder.net_destroy(self)
end

-- Кадровый обработчик. Движок вызывает его каждый кадр, начисляем раз в PERIOD_MS.
function bq_rad_tuner_binder:update(delta)
    object_binder.update(self, delta)

    local actor = db.actor
    if not actor then return end

    local st  = _G.bq_inv_rad
    local now = time_global()

    -- Время копится КАЖДЫЙ кадр, а начисляем, когда накопилось на PERIOD_MS.
    -- ВАЖНО: дельта считается от момента ПОСЛЕДНЕГО НАЧИСЛЕНИЯ, а не от
    -- предыдущего вызова. Иначе пропущенные кадры терялись бы или, наоборот,
    -- доза завышалась (эту ошибку поймал тест: 0.0169 вместо 0.0150 за секунду).
    local dt = now - (st.accum_from or now)
    if dt < 0 then dt = 0 end
    if now < (st.next_tick or 0) then
        return
    end
    st.accum_from = now
    st.next_tick  = now + PERIOD_MS
    if dt > MAX_DELTA_MS then dt = MAX_DELTA_MS end
    if dt < 1 then dt = 1 end        -- не чаще одного начисления за один тик

    local ok, err = pcall(function()
        local sum, total, artefacts, belt = compute_sum(actor)
        st.cycles = st.cycles + 1
        st.sum = sum

        -- Диагностика: раз в 5 секунд, плюс при каждом изменении суммы.
        if now >= (st.last_log or 0) + 5000 or st.logged_sum ~= sum then
            st.last_log = now
            st.logged_sum = sum
            local actor_rad = -1
            local okr, r = pcall(function() return actor.radiation end)
            if okr and type(r) == "number" then actor_rad = r end
            dbg(string.format(
                "цикл=%d доза=%.6f dt=%dмс | предметов=%d артефактов=%d (на поясе %d) | радиация актора=%.6f",
                st.cycles, sum, dt, total, artefacts, belt, actor_rad))
        end

        if sum > 0 then
            actor:change_radiation(sum * dt / 1000)
        end
    end)

    if not ok then
        dbg("ОШИБКА в update турера: " .. tostring(err))
    end
end

function bind(obj)
    obj:bind_object(bq_rad_tuner_binder(obj))
end

----------------------------------------------------------------------------
-- Точки входа из конфига [callbacks] (mod_game_global_z_bq.ltx).
--
-- Их роль - заставить движок загрузить этот файл (скрипт аддона исполняется
-- только при обращении по имени, см. MEMO 33.7) и убедиться, что турер создан.
-- Считать радиацию ЗДЕСЬ НЕЛЬЗЯ: повторный вход в Lua из C++ внутри уже
-- исполняющегося Lua-колбэка валит игру (проверено вылетом 08.10.2026).
--
-- Семантика возврата у ключей разная:
--   OnKeyPress         - true означает "клавиша обработана" и НЕ дойдёт до игры;
--   OnCanMoveToPartner - false ЗАПРЕЩАЕТ торговлю (UIActorMenuTrade.cpp:339).
----------------------------------------------------------------------------
function on_key_press(key, action)
    ensure_tuner()
    return false
end

function on_can_move_to_partner(partner, item, r1, r2, weight, partner_weight, partner_max)
    ensure_tuner()
    return true
end

-- Если файл исполнился по другому поводу - тоже позаботимся о турере.
ensure_tuner()
