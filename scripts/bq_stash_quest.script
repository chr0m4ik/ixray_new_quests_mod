-- bq_stash_quest.script
-- Quest line: Unknown's stashes (Filya corpse -> 3 suitcases -> finale)

local CORPSE_SECTION     = "bq_zaton_stalker_filya"
local CORPSE_POS         = { x = 382,  y = 35.5, z = 26.5 }
local SUITCASE_1_POS     = { x = -21,  y = 26.5, z = 321.7 }
local SUITCASE_2_POS     = { x = 434,  y = 43,   z = -177 }
local SUITCASE_3_POS     = { x = -180.5, y = 8.88, z = 148 }

-- Финальная сцена на заправке
local FINAL_MAJOR_POS    = { x = -163,  y = 22, z = -170   }
local MERC_1_POS         = { x = -159.5, y = 22, z = -180  }
local MERC_2_POS         = { x = -173,  y = 22, z = -185   }
local MERC_3_POS         = { x = -158,  y = 22, z = -164.5 }

local TASK_GLOBAL = "bq_stash_hunt_task"
local TASK_STEP_1 = "bq_stash_step_1_task"
local TASK_STEP_2 = "bq_stash_step_2_task"
local TASK_STEP_3 = "bq_stash_step_3_task"
local TASK_STEP_4 = "bq_stash_step_4_task"
local TASK_STEP_5 = "bq_stash_step_5_task"
local TASK_STEP_6 = "bq_stash_step_6_task"
local TASK_STEP_7 = "bq_stash_step_7_task"

local callback_backend = nil
local initialized      = false
local next_update      = 0

local function dbg(msg)
    local f = io.open("bq_debug.log", "a")
    if f then
        f:write(os.date("%H:%M:%S") .. "  " .. msg .. "\n")
        f:close()
    end
end

-- Forward declarations
local spawn_suitcase_1
local spawn_suitcase_3
local spawn_bridge_suitcase
local spawn_final_squad
local remove_corpse

----------------------------------------------------------------------
-- Спавн предметов без AI-сетки
----------------------------------------------------------------------

local function spawn_item_no_ai(section, coords)
    if not bq_state.is_zaton() then
        dbg("spawn_item_no_ai: not on Zaton")
        return nil
    end
    if not system_ini():section_exist(section) then
        dbg("spawn_item_no_ai: section " .. section .. " MISSING")
        return nil
    end
    local position = vector():set(coords.x, coords.y, coords.z)
    local lvid = level.vertex_id(position)
    local gvid = db.actor:game_vertex_id()
    local se = alife():create(section, position, lvid, gvid)
    if not se then
        dbg("spawn_item_no_ai: alife():create returned nil for " .. section)
        return nil
    end
    se:use_ai_locations(false)
    local cl = level.object_by_id(se.id)
    if cl then cl:use_ai_locations(false) end
    dbg("spawn_item_no_ai: " .. section .. " id=" .. tostring(se.id)
        .. " lvid=" .. tostring(lvid) .. " gvid=" .. tostring(gvid))
    return se
end

----------------------------------------------------------------------
-- Утилиты
----------------------------------------------------------------------

local function set_task_state(id, state)
    if db.actor:get_task(id, true) then db.actor:set_task_state(state, id, 0) end
end

local function give_task(id, title, description, priority)
    if db.actor:get_task(id, false) then return end
    local objective = CGameTask()
    objective:set_id(id)
    objective:set_type(task.additional)
    objective:set_title(game.translate_string(title))
    objective:set_description(game.translate_string(description))
    objective:set_priority(priority)
    objective:set_icon_name("ui_inGame2_Sdelka")
    objective:add_complete_func("bq_stash_quest.poll_task")
    db.actor:give_task(objective, 0, true, 0)
end

local function fail_task(id)
    if db.actor:get_task(id, true) then db.actor:set_task_state(task.failed, id, 0) end
end

local function has_item(section)
    return db.actor and db.actor:object(section) ~= nil
end

----------------------------------------------------------------------
-- Филя
----------------------------------------------------------------------

local function try_kill_corpse()
    if not has_alife_info("bq_corpse_spawned") then return end
    if has_alife_info("bq_corpse_killed")   then return end
    local se = bq_state.find(CORPSE_SECTION, "filya_id")
    if not se then return end
    local cl = level.object_by_id(se.id)
    if not cl then return end
    if cl:alive() then cl:kill(nil) return end
    db.actor:give_info_portion("bq_corpse_killed")
    dbg("corpse killed")
end

local function attach_pda_to_corpse()
    if not has_alife_info("bq_corpse_killed") then return end
    if has_alife_info("bq_pda_1_spawned")     then return end
    local se = bq_state.find(CORPSE_SECTION, "filya_id")
    if not se then return end
    alife():create("bq_pda_1",
        se.position, se.m_level_vertex_id, se.m_game_vertex_id, se.id)
    db.actor:give_info_portion("bq_pda_1_spawned")
    dbg("pda_1 attached to corpse")
end

local function spawn_corpse()
    if has_alife_info("bq_corpse_spawned") then return end
    if not bq_state.is_zaton() then
        bq_state.store("bq_stash_pending", true)
        return
    end
    if bq_state.find(CORPSE_SECTION, "filya_id") then
        db.actor:give_info_portion("bq_corpse_spawned")
        return
    end
    local se = bq_state.spawn(CORPSE_SECTION, "filya_id", CORPSE_POS)
    if not se then dbg("spawn_corpse FAILED") return end
    dbg("corpse spawned id=" .. tostring(se.id))
    db.actor:give_info_portion("bq_corpse_spawned")
end

remove_corpse = function()
    if has_alife_info("bq_corpse_removed") then return end
    local se = bq_state.find(CORPSE_SECTION, "filya_id")
    if se then alife():release(se, true) end
    db.actor:give_info_portion("bq_corpse_removed")
    dbg("corpse removed")
end

----------------------------------------------------------------------
-- Спавн чемоданов
----------------------------------------------------------------------

spawn_suitcase_1 = function()
    dbg("spawn_suitcase_1 ENTER")
    if bq_state.find("bq_suitcase", "suitcase_1_id") then
        if not has_alife_info("bq_suitcase_1_spawned") then
            db.actor:give_info_portion("bq_suitcase_1_spawned")
        end
        return
    end
    if has_alife_info("bq_suitcase_1_spawned") then
        db.actor:disable_info_portion("bq_suitcase_1_spawned")
        dbg("  -> stale info reset")
    end
    local se = spawn_item_no_ai("bq_suitcase", SUITCASE_1_POS)
    if not se then dbg("  -> FAILED") return end
    bq_state.remember("bq_suitcase", "suitcase_1_id", se)
    db.actor:give_info_portion("bq_suitcase_1_spawned")
    dbg("  -> OK")
end

spawn_bridge_suitcase = function()
    dbg("spawn_bridge_suitcase ENTER")
    if bq_state.find("bq_suitcase_2", "suitcase_2_id") then
        if not has_alife_info("bq_suitcase_2_spawned") then
            db.actor:give_info_portion("bq_suitcase_2_spawned")
        end
        return
    end
    if has_alife_info("bq_suitcase_2_spawned") then
        db.actor:disable_info_portion("bq_suitcase_2_spawned")
        dbg("  -> stale info reset")
    end
    local se = spawn_item_no_ai("bq_suitcase_2", SUITCASE_2_POS)
    if not se then dbg("  -> FAILED") return end
    bq_state.remember("bq_suitcase_2", "suitcase_2_id", se)
    db.actor:give_info_portion("bq_suitcase_2_spawned")
    dbg("  -> OK")
end

spawn_suitcase_3 = function()
    dbg("spawn_suitcase_3 ENTER")
    if bq_state.find("bq_suitcase_3", "suitcase_3_id") then
        if not has_alife_info("bq_suitcase_3_spawned") then
            db.actor:give_info_portion("bq_suitcase_3_spawned")
        end
        return
    end
    if has_alife_info("bq_suitcase_3_spawned") then
        db.actor:disable_info_portion("bq_suitcase_3_spawned")
        dbg("  -> stale info reset")
    end
    local se = spawn_item_no_ai("bq_suitcase_3", SUITCASE_3_POS)
    if not se then dbg("  -> FAILED") return end
    bq_state.remember("bq_suitcase_3", "suitcase_3_id", se)
    db.actor:give_info_portion("bq_suitcase_3_spawned")
    dbg("  -> OK")
end

----------------------------------------------------------------------
-- Финальная сцена: Майор и три наёмника
----------------------------------------------------------------------

local FINAL_SQUAD = {
    { section = "bq_zaton_major",         key = "major_id", pos = FINAL_MAJOR_POS },
    { section = "bq_zaton_merc_corpse_1", key = "merc1_id", pos = MERC_1_POS      },
    { section = "bq_zaton_merc_corpse_2", key = "merc2_id", pos = MERC_2_POS      },
    { section = "bq_zaton_merc_corpse_3", key = "merc3_id", pos = MERC_3_POS      },
}

spawn_final_squad = function()
    if has_alife_info("bq_final_squad_spawned") then return end
    if not bq_state.is_zaton() then return end
    local all_ok = true
    for _, spec in ipairs(FINAL_SQUAD) do
        local se = bq_state.find(spec.section, spec.key)
        if not se then
            se = bq_state.spawn(spec.section, spec.key, spec.pos)
        end
        if se then
            dbg("final squad: " .. spec.section .. " id=" .. tostring(se.id))
        else
            dbg("final squad: FAILED to spawn " .. spec.section)
            all_ok = false
        end
    end
    if all_ok then
        db.actor:give_info_portion("bq_final_squad_spawned")
        dbg("final squad spawned")
    end
end

local function try_kill_final_squad()
    if not has_alife_info("bq_final_squad_spawned") then return end
    if has_alife_info("bq_final_squad_killed")   then return end
    local all_dead = true
    for _, spec in ipairs(FINAL_SQUAD) do
        local se = bq_state.find(spec.section, spec.key)
        if not se then
            all_dead = false
        else
            local cl = level.object_by_id(se.id)
            if cl and cl:alive() then
                cl:kill(nil)
                all_dead = false
            end
        end
    end
    if all_dead then
        db.actor:give_info_portion("bq_final_squad_killed")
        dbg("final squad killed")
    end
end

local function attach_loot_to_major()
    if not has_alife_info("bq_final_squad_killed") then return end
    if has_alife_info("bq_major_loot_spawned")     then return end
    local se = bq_state.find("bq_zaton_major", "major_id")
    if not se then return end
    alife():create("bq_pda_5",
        se.position, se.m_level_vertex_id, se.m_game_vertex_id, se.id)
    alife():create("cs_heavy_outfit",
        se.position, se.m_level_vertex_id, se.m_game_vertex_id, se.id)
    alife():create("wpn_abakan",
        se.position, se.m_level_vertex_id, se.m_game_vertex_id, se.id)
    alife():create_ammo("ammo_5.45x39_fmj",
        se.position, se.m_level_vertex_id, se.m_game_vertex_id, se.id, 180)
    db.actor:give_info_portion("bq_major_loot_spawned")
    dbg("loot attached to Major")
end

----------------------------------------------------------------------
-- Отслеживание предметов у актора
----------------------------------------------------------------------

local function check_pda_1()
    if has_alife_info("bq_pda_1_taken") then return end
    if not has_item("bq_pda_1") then return end
    dbg("check_pda_1: pda detected")
    db.actor:give_info_portion("bq_pda_1_taken")
    db.actor:give_info_portion("bq_quest_2_started")
    give_task(TASK_GLOBAL, "bq_stash_hunt_name", "bq_stash_hunt_descr", 5)
    give_task(TASK_STEP_1, "bq_stash_step_1_name", "bq_stash_step_1_descr", 6)
    spawn_suitcase_1()
end

local function check_suitcase_1()
    if has_alife_info("bq_suitcase_taken") then return end
    if not has_item("bq_suitcase") then return end
    dbg("check_suitcase_1: suitcase detected")
    db.actor:give_info_portion("bq_suitcase_taken")
    set_task_state(TASK_STEP_1, task.completed)
    give_task(TASK_STEP_2, "bq_stash_step_2_name", "bq_stash_step_2_descr", 6)
end

local function check_suitcase_2()
    if has_alife_info("bq_suitcase_2_taken") then return end
    if not has_item("bq_suitcase_2") then return end
    db.actor:give_info_portion("bq_suitcase_2_taken")
    set_task_state(TASK_STEP_3, task.completed)
    give_task(TASK_STEP_4, "bq_stash_step_4_name", "bq_stash_step_4_descr", 6)
end

local function check_suitcase_3()
    if has_alife_info("bq_suitcase_3_taken") then return end
    if not has_item("bq_suitcase_3") then return end
    db.actor:give_info_portion("bq_suitcase_3_taken")
    set_task_state(TASK_STEP_5, task.completed)
    give_task(TASK_STEP_6, "bq_stash_step_6_name", "bq_stash_step_6_descr", 6)
    remove_corpse()
end

local function check_pda_5()
    if has_alife_info("bq_pda_5_taken") then return end
    if not has_item("bq_pda_5") then return end
    dbg("check_pda_5: Major's PDA taken, quest finished")
    db.actor:give_info_portion("bq_pda_5_taken")
    set_task_state(TASK_STEP_7, task.completed)
    set_task_state(TASK_GLOBAL, task.completed)
end

local function check_suitcase_sold()
    if has_alife_info("bq_suitcase_opened") then return end

    if has_alife_info("bq_suitcase_sold") then
        if has_item("bq_suitcase") then
            db.actor:disable_info_portion("bq_suitcase_sold")
            set_task_state(TASK_STEP_1, task.completed)
            set_task_state(TASK_STEP_2, task.active)
            set_task_state(TASK_GLOBAL, task.active)
            dbg("check_suitcase_sold: restored task after buyback")
        end
        return
    end

    if not has_alife_info("bq_suitcase_taken") then return end
    if has_item("bq_suitcase") then return end

    db.actor:give_info_portion("bq_suitcase_sold")
    fail_task(TASK_STEP_2)
    fail_task(TASK_GLOBAL)
    remove_corpse()
    dbg("check_suitcase_sold: suitcase gone, task failed")
end

----------------------------------------------------------------------
-- Проверки для диалогов (механик)
----------------------------------------------------------------------

function can_open_suitcase_1_ok()
    on_game_start()
    return has_item("bq_suitcase")
        and not has_alife_info("bq_suitcase_opened")
        and db.actor:money() >= 2000
end

function can_open_suitcase_1_no_money()
    on_game_start()
    return has_item("bq_suitcase")
        and not has_alife_info("bq_suitcase_opened")
        and db.actor:money() < 2000
end

function can_open_suitcase_2_ok()
    on_game_start()
    return has_item("bq_suitcase_2")
        and not has_alife_info("bq_suitcase_2_opened")
        and db.actor:money() >= 2000
end

function can_open_suitcase_2_no_money()
    on_game_start()
    return has_item("bq_suitcase_2")
        and not has_alife_info("bq_suitcase_2_opened")
        and db.actor:money() < 2000
end

function can_open_suitcase_3_ok()
    on_game_start()
    return has_item("bq_suitcase_3")
        and not has_alife_info("bq_suitcase_3_opened")
        and db.actor:money() >= 2000
end

function can_open_suitcase_3_no_money()
    on_game_start()
    return has_item("bq_suitcase_3")
        and not has_alife_info("bq_suitcase_3_opened")
        and db.actor:money() < 2000
end

----------------------------------------------------------------------
-- Действия диалога
----------------------------------------------------------------------

function open_suitcase_1(first_speaker, second_speaker)
    dbg("open_suitcase_1 called")
    if not bq_state.ready() then return end
    if not has_item("bq_suitcase") then return end
    if has_alife_info("bq_suitcase_opened") then return end
    if db.actor:money() < 2000 then return end

    db.actor:give_money(-2000)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "bq_suitcase", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "af_eye", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "wpn_fort_snag", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "bq_pda_2", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "ammo_9x18_fmj", 32)

    db.actor:give_info_portion("bq_suitcase_opened")
    dbg("open_suitcase_1 done")
end

function open_suitcase_2(first_speaker, second_speaker)
    dbg("open_suitcase_2 called")
    if not bq_state.ready() then return end
    if not has_item("bq_suitcase_2") then return end
    if has_alife_info("bq_suitcase_2_opened") then return end
    if db.actor:money() < 2000 then return end

    db.actor:give_money(-2000)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "bq_suitcase_2", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "helm_tactic", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "af_cristall_flower", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "bq_pda_3", 1)

    db.actor:give_info_portion("bq_suitcase_2_opened")
    dbg("open_suitcase_2 done")
end

function open_suitcase_3(first_speaker, second_speaker)
    dbg("open_suitcase_3 called")
    if not bq_state.ready() then return end
    if not has_item("bq_suitcase_3") then return end
    if has_alife_info("bq_suitcase_3_opened") then return end
    if db.actor:money() < 2000 then return end

    db.actor:give_money(-2000)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "bq_suitcase_3", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "wpn_spas12", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "ammo_12x70_buck", 3)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "af_ice", 1)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "bq_pda_4", 1)

    db.actor:give_info_portion("bq_suitcase_3_opened")
    dbg("open_suitcase_3 done")
end

----------------------------------------------------------------------
-- Отложенная реакция на вскрытие чемодана
----------------------------------------------------------------------

local function react_suitcase_opened()
    if has_alife_info("bq_suitcase_opened")
        and not has_alife_info("bq_suitcase_reacted") then
        dbg("react: suitcase 1 opened")
        db.actor:give_info_portion("bq_suitcase_reacted")
        set_task_state(TASK_STEP_2, task.completed)
        give_task(TASK_STEP_3, "bq_stash_step_3_name", "bq_stash_step_3_descr", 6)
        spawn_bridge_suitcase()
    end
    if has_alife_info("bq_suitcase_2_opened")
        and not has_alife_info("bq_suitcase_2_reacted") then
        dbg("react: suitcase 2 opened")
        db.actor:give_info_portion("bq_suitcase_2_reacted")
        set_task_state(TASK_STEP_4, task.completed)
        give_task(TASK_STEP_5, "bq_stash_step_5_name", "bq_stash_step_5_descr", 6)
        spawn_suitcase_3()
    end
    if has_alife_info("bq_suitcase_3_opened")
        and not has_alife_info("bq_suitcase_3_reacted") then
        dbg("react: suitcase 3 opened")
        db.actor:give_info_portion("bq_suitcase_3_reacted")
        set_task_state(TASK_STEP_6, task.completed)
        give_task(TASK_STEP_7, "bq_stash_step_7_name", "bq_stash_step_7_descr", 7)
        spawn_final_squad()
    end
end

----------------------------------------------------------------------
-- Инициализация
----------------------------------------------------------------------

function start()
    dbg("==== start() called ====")
    on_game_start()
    spawn_corpse()
end

function update()
    if not bq_state.ready() then return end

    if not initialized then
        initialized = true
        dbg("update: first init")
        if has_alife_info("bq_docs_delivered") or has_alife_info("bq_docs_sold") then
            spawn_corpse()
        end
    end

    if bq_state.retrieve("bq_stash_pending", false) and bq_state.is_zaton() then
        bq_state.store("bq_stash_pending", false)
        spawn_corpse()
    end

    local now = time_global()
    if now < next_update then return end
    next_update = now + 500

    try_kill_corpse()
    attach_pda_to_corpse()
    check_pda_1()
    check_suitcase_1()
    check_suitcase_2()
    check_suitcase_3()
    check_suitcase_sold()
    check_pda_5()
    react_suitcase_opened()

    -- Отложенный спавн финальной сцены на случай загрузки сейва
    -- с уже вскрытым третьим чемоданом.
    if has_alife_info("bq_suitcase_3_reacted")
        and not has_alife_info("bq_final_squad_spawned") then
        spawn_final_squad()
    end
    try_kill_final_squad()
    attach_loot_to_major()
end

function on_game_load()
    dbg("==== on_game_load ====")
    initialized = false
    next_update = 0
end

function on_game_start()
    local backend = (ixr_framework and ixr_framework.is_module_loaded("ixr_signals")) and ixr_framework or _G
    if callback_backend == backend then return end
    RegisterScriptCallback("update", update)
    RegisterScriptCallback("load", on_game_load)
    callback_backend = backend
end

function poll_task()
    on_game_start()
    return false
end

on_game_start()