-- bq_containers.script
-- Механика контейнеров для артефактов: полевой, универсальный, научный.
--
-- ВЛОЖИТЬ: перетащить артефакт на пустой контейнер.
--   Контейнер и артефакт исчезают, появляется комбо-предмет
--   "<артефакт>_<контейнер>" (секции лежат в configs\misc\mod_artefacts_z_bq.ltx).
-- ДОСТАТЬ: правый клик по комбо-предмету -> "Достать артефакт".
--   Комбо-предмет исчезает, возвращаются артефакт и пустой контейнер.
--
-- ПОЧЕМУ ЗАМЕНА ОТЛОЖЕННАЯ: менять инвентарь прямо внутри обработчика
-- перетаскивания нельзя, движок в этот момент сам правит список предметов
-- (проверено вылетом, MEMO 15.1 п.5). Колбэк только запоминает id, а замена
-- выполняется на следующем кадре в обработчике update.
--
-- ПОЧЕМУ КОЛЬЦО ОБХОДА, А НЕ ПРЯМАЯ ПРОВЕРКА: таблицы вида
-- ON_DROP[bq_field_container] ломаются на вложенных ключах, поэтому
-- соответствие "секция контейнера -> суффикс комбо" лежит плоским списком
-- CONTAINERS и ищется перебором: "bq_field_container" -> "field_container",
-- "bq_uni_container" -> "bq_uni_container".
--
-- ОТЛАДКА: log() из скриптов аддона в игровой лог не попадает (MEMO 13.5),
-- поэтому пишем в файл bq_containers.log в корне игры.

-- Секция контейнера -> суффикс комбо-секции. Имя комбо = <артефакт>_<суффикс>.
--
-- ВНИМАНИЕ: суффикс НЕ всегда равен имени секции контейнера. У полевого
-- контейнера суффикс без префикса bq_ (`af_eye_bq_field_container`), у
-- универсального и научного - с префиксом (`af_eye_bq_uni_container`).
-- Это историческое правило (шаблон из прежней версии мода), и оно совпадает
-- с именами секций в конфиге, поэтому менять его нельзя: у заказчика уже есть
-- сейвы с заспавненными комбо, и переименование секций их сломает.
-- Именно из-за этого несовпадения полевое комбо не находилось по имени.
local CONTAINERS = {
    { section = "bq_field_container", combo = "bq_field_container" },
    { section = "bq_uni_container",   combo = "bq_uni_container" },
    { section = "bq_sci_container",   combo = "bq_sci_container" },
}

-- Секция контейнера -> звук вложения (файлы берутся на этапе звуков).
local SOUND_BY_CONTAINER = {
    bq_field_container = "interface\\inv_iam_open",
    bq_uni_container   = "interface\\inv_aac_open",
    bq_sci_container   = "interface\\inv_aam_open",
}

local LOG_FILE = "bq_containers.log"

local pending   = nil
local snd_cache = {}

local function dbg(msg)
    local f = io.open(LOG_FILE, "a")
    if f then
        f:write(os.date("%H:%M:%S") .. "  " .. msg .. "\n")
        f:close()
    end
end

-- Звук (2D). Вызов в pcall: битый звук не должен срывать замену предметов.
local function play_sound(path)
    if not path then return end
    local ok, err = pcall(function()
        local snd = snd_cache[path]
        if not snd then
            snd = sound_object(path)
            snd_cache[path] = snd
        end
        if snd then
            snd:play_no_feedback(db.actor, sound_object.s2d, 0, vector():set(0, 0, 0), 1.0)
        else
            dbg("звук не загрузился: " .. path)
        end
    end)
    if not ok then dbg("ошибка звука '" .. path .. "': " .. tostring(err)) end
end

local function container_section_of(object)
    if not object then return nil end
    local sec = object:section()
    for _, item in ipairs(CONTAINERS) do
        -- ВАЖНО: ничего не присваивать полям таблицы CONTAINERS. Ранее здесь
        -- было item.combo = item.section, из-за чего первый элемент таблицы
        -- портился и последующие поиски комбо ломались.
        local candidate = item.section
        if candidate == sec then return candidate end
    end
    return nil
end

-- Суффикс комбо по секции контейнера (см. таблицу CONTAINERS).
local function combo_suffix_of(container_section)
    for _, item in ipairs(CONTAINERS) do
        if item.section == container_section then return item.combo end
    end
    return nil
end

-- Секция комбо по секции артефакта и секции контейнера:
--   <артефакт> .. "_" .. <суффикс контейнера>.
-- Если комбо-секции нет (генератор её ещё не создал), вернём nil.
local function combo_section_of(artifact_section, container_section)
    if not artifact_section or not container_section then return nil end
    local suffix = combo_suffix_of(container_section)
    if not suffix then return nil end
    local candidate = artifact_section .. "_" .. suffix
    if system_ini():section_exist(candidate) then
        return candidate
    end
    return nil
end

-- Разбор секции комбо на артефакт и контейнер.
-- "af_eye_bq_field_container" -> ("af_eye", "bq_field_container")
local function split_combo(combo_section)
    if not combo_section then return nil, nil end
    for _, item in ipairs(CONTAINERS) do
        local marker = "_" .. item.combo
        local n = string.len(marker)
        if string.len(combo_section) > n
            and string.sub(combo_section, -n) == marker then
            local artifact = string.sub(combo_section, 1, -(n + 1))
            if system_ini():section_exist(artifact) then
                return artifact, item.section
            end
        end
    end
    return nil, nil
end

local function owned_by_actor(object)
    -- db.actor.id — функция, а не число, поэтому именно :id().
    return object ~= nil and object.parent_id == db.actor:id()
end

local function actor_vertices()
    return db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id()
end

----------------------------------------------------------------------------
-- Замена предметов.
--
-- ИСТОРИЯ И ПРИЧИНА ПЕРЕДЕЛКИ. Раньше замена всегда откладывалась на "следующий
-- кадр" через обработчик update. Откладывать действительно нужно: менять
-- инвентарь ПРЯМО ВНУТРИ обработчика перетаскивания нельзя, движок в этот момент
-- сам правит список (MEMO 15.1 п.5, проверено вылетом). Но в этой сборке
-- подписка на update ненадёжна: реестр колбэков живёт в локальной таблице
-- `dynamic_callbacks.lua` и пересоздаётся вместе с Lua-машиной, после чего
-- apply_pending перестаёт вызываться и замена не применяется никогда
-- (проверено логом: ни одной строки ЗАМЕНА при работающем OnItemDropped).
--
-- Поэтому порядок такой:
--   1. движок вызывает OnItemDropped ПОСЛЕ того, как сам закончил обработку
--      перетаскивания (UIActorMenu_action.cpp:184-190, уже вне правки списка) -
--      здесь пробуем выполнить замену сразу;
--   2. если не вышло (инвентарь занят, предмет не у актора) - кладём задачу в
--      pending, и её добьёт apply_pending, ЕСЛИ обработчик update работает.
-- Так механика работает и без реестра колбэков, а отложенный путь остаётся
-- страховкой, а не единственным способом.
----------------------------------------------------------------------------

local function swap(task)
    if not task then return false end
    if not db.actor or not alife() then return false end

    local position, lvid, gvid = actor_vertices()

    if task.mode == "put" then
        local artifact  = alife():object(task.artifact_id)
        local container = alife():object(task.container_id)
        if not artifact or not container then
            dbg("ОТМЕНА(put): предмет исчез")
            return true            -- повторять бессмысленно
        end
        if not owned_by_actor(artifact) or not owned_by_actor(container) then
            dbg("ОТМЕНА(put): предмет не у актора")
            return true
        end
        dbg("ЗАМЕНА(put): " .. artifact:section_name()
            .. " + " .. container:section_name() .. " -> " .. task.combo)
        alife():release(artifact, true)
        alife():release(container, true)
        local created = alife():create(task.combo, position, lvid, gvid, db.actor:id())
        if created then
            dbg("  ГОТОВО, комбо id=" .. tostring(created.id))
            play_sound(task.sound)
            return true
        end
        dbg("  ОШИБКА: комбо не создался")
        return true

    elseif task.mode == "take" then
        local combo = alife():object(task.combo_id)
        if not combo then
            dbg("ОТМЕНА(take): комбо исчез")
            return true
        end
        if not owned_by_actor(combo) then
            dbg("ОТМЕНА(take): комбо не у актора")
            return true
        end
        dbg("ЗАМЕНА(take): " .. combo:section_name()
            .. " -> " .. task.artifact .. " + " .. task.container)
        alife():release(combo, true)
        local artifact  = alife():create(task.artifact, position, lvid, gvid, db.actor:id())
        local container = alife():create(task.container, position, lvid, gvid, db.actor:id())
        if artifact and container then
            dbg("  ГОТОВО")
            play_sound(task.sound)
            return true
        end
        dbg("  ОШИБКА: артефакт или контейнер не создался")
        return true
    end
    return true
end

-- Попытка выполнить замену сразу, из движкового колбэка.
-- Возвращает true, если задача решена (или решена быть не может).
local function try_swap_now(task)
    local ok, done = pcall(swap, task)
    if not ok then
        dbg("замена отложена (исключение): " .. tostring(done))
        return false
    end
    return done == true
end

-- Выполняется из обработчика update, если он вообще вызывается.
local function do_apply()
    if not pending then return end
    local task = pending
    pending = nil
    swap(task)
end

local function apply_pending()
    -- ВРЕМЕННАЯ ДИАГНОСТИКА: пишем по таймеру, чтобы по логу было видно,
    -- работает ли рассылка update вообще. Убрать после разбора.
    _G.bq_diag = _G.bq_diag or { cont_tick = 0, cont_work = 0, rad_tick = 0 }
    _G.bq_diag.cont_tick = _G.bq_diag.cont_tick + 1
    local now = time_global()
    if now >= (_G.bq_diag.cont_next_log or 0) then
        _G.bq_diag.cont_next_log = now + 5000
        dbg("ДИАГ: контейнеры tick=" .. _G.bq_diag.cont_tick
            .. " pending=" .. tostring(pending ~= nil)
            .. " is_talking=" .. tostring(db.actor and db.actor:is_talking()))
    end
    if not pending then return end
    _G.bq_diag.cont_work = _G.bq_diag.cont_work + 1
    if not db.actor or not alife() then return end
    if db.actor:is_talking() then
        dbg("ДИАГ: apply_pending отложен, актор разговаривает")
        return
    end
    local ok, err = pcall(do_apply)
    if not ok then
        pending = nil
        dbg("ОШИБКА в apply_pending: " .. tostring(err))
    end
end

----------------------------------------------------------------------------
-- 1) Вложение: перетаскивание артефакта на пустой контейнер.
--    Колбэк включён строкой OnItemDropped в configs\mod_game_global_z_bq.ltx.
----------------------------------------------------------------------------
function on_item_dropped(first, second)
    if not db.actor or not alife() then return true end
    if not first or not second then return true end

    local container = container_section_of(second)
    if not container then return true end          -- цель не контейнер

    local artifact = first:section()
    local combo = combo_section_of(artifact, container)
    if not combo then
        dbg("вложение: нет комбо-секции для '" .. tostring(artifact)
            .. "' в '" .. tostring(container) .. "'")
        return true
    end

    local task = {
        mode         = "put",
        artifact_id  = first:id(),
        container_id = second:id(),
        combo        = combo,
        sound        = SOUND_BY_CONTAINER[container],
    }
    dbg("вложение принято: '" .. tostring(artifact) .. "' + '"
        .. tostring(container) .. "' -> '" .. combo .. "'")

    -- Пробуем выполнить сразу: движок вызывает этот колбэк уже ПОСЛЕ своей
    -- обработки перетаскивания. Если не вышло - задача уйдёт в pending.
    if not try_swap_now(task) then
        pending = task
    end
    return true
end

----------------------------------------------------------------------------
-- 2) Доставание: кнопка на комбо-предмете (use1_functor в его секции).
--    Функция обязана вернуть false: в IX-Ray use1_functor — это УСЛОВИЕ
--    (UIActorMenuInventory.cpp:1389), и при true движок попытается "съесть"
--    предмет.
--
--    Замена выполняется сразу. Раньше она откладывалась на update, но в этой
--    сборке подписка на update не срабатывает, и доставание не работало вообще.
--    Если немедленная замена почему-то не пройдёт, задача останется в pending
--    и её добьёт apply_pending, когда обработчик update всё-таки вызовется.
----------------------------------------------------------------------------
function take_artifact(combo)
    if not db.actor or not alife() or not combo then return false end

    local combo_section = combo:section()
    local artifact, container = split_combo(combo_section)
    if not artifact or not container then
        dbg("доставание: '" .. tostring(combo_section) .. "' не распознан как комбо")
        return false
    end

    local task = {
        mode      = "take",
        combo_id  = combo:id(),
        artifact  = artifact,
        container = container,
        sound     = SOUND_BY_CONTAINER[container],
    }
    dbg("доставание принято: '" .. combo_section .. "' -> '"
        .. artifact .. "' + '" .. container .. "'")

    if not try_swap_now(task) then
        pending = task
    end
    return false
end

----------------------------------------------------------------------------
-- Точки входа, которые движок дёргает сам (объявлены в [callbacks]).
--
-- Их задача - только (пере)установить подписку. ВЫПОЛНЯТЬ ЗАМЕНУ ЗДЕСЬ НЕЛЬЗЯ:
-- повторный вход в Lua из C++ внутри уже исполняющегося Lua-колбэка валит игру
-- в luabind::class_rep::function_dispatcher. Именно на этом игра вылетала при
-- открытии инвентаря (08.10.2026): стек CInput::KeyboardUpdate -> lua_pcall ->
-- function_dispatcher -> lua_pcall -> function_dispatcher.
--
-- Наведение на предмет в инвентаре. Возврат этого ключа движок игнорирует
-- (UIActorMenu_action.cpp:347-357), поэтому возвращаем true.
----------------------------------------------------------------------------
function on_item_focus(item)
    RegisterScriptCallback("update", apply_pending)
    return true
end

----------------------------------------------------------------------------
-- Первичная установка при исполнении модуля.
----------------------------------------------------------------------------
dbg("==== скрипт контейнеров загружен ====")
RegisterScriptCallback("update", apply_pending)
