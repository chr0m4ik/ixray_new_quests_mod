-- Контейнеры для артефактов (полевой, универсальный, научный, СИМК).
--
-- Вся работа с данными - в движке (класс CInventoryArtefactContainer): перенос
-- характеристик вложенного артефакта, поглощение радиации, флаги belt/can_trade,
-- иконка и слой. Здесь только события, звук и создание/удаление предметов.
--
-- ВАЖНО (почему всё отложено): ошибка Lua внутри обработчика перетаскивания
-- превращается в C++-исключение и роняет игру - в логе видно
-- "luabind::detail::proxy_functor_caller<...>::operator bool() ->
--  CUIActorMenu::OnItemDrop()". Поэтому обработчики только ставят задачу, а
-- сами операции с предметами выполняются на следующем update (так же делала
-- прежняя версия скрипта), и каждый шаг завёрнут в pcall с записью ошибки в лог.
local SOUND_BY_CONTAINER = {
    bq_field_container = "interface\\inv_iam_open",
    bq_uni_container   = "interface\\inv_aac_open",
    bq_sci_container   = "interface\\inv_aam_open",
    -- СИМК: свои звуки заказчика (sounds\interface\inv_lead_open.ogg и
    -- inv_lead_close.ogg). Открытие - когда кладём артефакт, закрытие - когда
    -- достаём. Файлы лежат в аддоне, движок грузит их по пути, без sounds.ltx.
    bq_simk_container  = "interface\\inv_lead_open",
}

local SOUND_TAKE_BY_CONTAINER = {
    bq_simk_container = "interface\\inv_lead_close",
}

local LOG_FILE = "$logs$\\bq_containers.log"

-- Логирование намеренно полностью в pcall: dbg вызывается и из обработчиков
-- ошибок, а любая ошибка Lua в этих местах роняет игру (см. комментарий выше).
local function dbg(msg)
    -- ОТКЛЮЧЕНО ДЛЯ РЕЛИЗА: запись во внешний лог-файл не нужна пользователю.
    -- Чтобы включить отладку - раскомментируйте тело ниже.
    -- local f = io.open(LOG_FILE, "a")
    -- if f then
    --     f:write(os.date("%H:%M:%S") .. "  " .. tostring(msg) .. "\n")
    --     f:close()
    -- end
end

-- Кэш звуков: объект звука нельзя отпускать, пока он играет, иначе движок выдаёт
-- "CScriptSound::~CScriptSound: playing sound is not completed, but is destroying".
local snd_cache = {}

local function play_sound(path)
    if not path then return end
    local snd = snd_cache[path]
    if not snd then
        local ok, obj = pcall(function() return xr_sound.get_safe_sound_object(path) end)
        if not ok or not obj then
            ok, obj = pcall(function() return sound_object(path) end)
        end
        if not ok or not obj then
            dbg("звук не загрузился: " .. tostring(path))
            return
        end
        snd = obj
        snd_cache[path] = snd
    end
    local flag = sound_object and sound_object.s2d
    local played = false
    if flag ~= nil then
        played = pcall(function() snd:play(db.actor, 0, flag) end)
    end
    if not played then
        played = pcall(function() snd:play(db.actor) end)
    end
    if not played then
        dbg("звук не проигрался: " .. tostring(path))
    end
end

local function get_condition(item)
    local ok, value = pcall(function() return item:condition() end)
    if ok and type(value) == "number" then return value end
    return nil
end

local function set_condition(item, value)
    pcall(function() item:set_condition(value) end)
end

local CONTAINERS = {
    bq_field_container = true,
    bq_uni_container   = true,
    bq_sci_container   = true,
    bq_simk_container  = true,
}

local function cls_of(section)
    local cls = nil
    pcall(function()
        local ini = system_ini()
        if ini:section_exist(section) and ini:line_exist(section, "class") then
            cls = ini:r_string(section, "class")
        end
    end)
    return cls
end

local function is_container(section)
    if CONTAINERS[section] then return true end
    return cls_of(section) == "II_BQCNT"
end

local function is_artefact(section)
    if is_container(section) then return false end
    local cls = cls_of(section)
    return cls == "ARTEFACT" or cls == "SCRPTART"
end

local pending = nil

local function apply_pending()
    if not pending then return end
    local task = pending
    pending = nil
    local ok, err = pcall(function()
        if task.mode == "put" then
            local container = level.object_by_id(task.container_id)
            local artefact  = level.object_by_id(task.artifact_id)
            if not container then return end
            local cond = nil
            if artefact then cond = get_condition(artefact) end
            if cond == nil then cond = task.condition end
            if container:bq_put_artefact(task.artifact, cond) then
                if artefact then
                    local se = alife():object(task.artifact_id)
                    if se then alife():release(se, true) end
                end
                play_sound(task.sound)
                dbg(string.format("вложено: %s -> %s (состояние %.3f)", task.artifact, container:section(), cond))
            else
                dbg("вложение не удалось: " .. tostring(task.artifact))
            end
        elseif task.mode == "take" then
            local container = level.object_by_id(task.container_id)
            if not container then return end
            local art_section = container:bq_inner_artefact()
            local cond = get_condition(container)
            container:bq_clear_artefact()
            local actor = db.actor
            local obj = alife():create(art_section, actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
            if obj then
                local itm = level.object_by_id(obj.id)
                if itm and cond ~= nil then set_condition(itm, cond) end
            end
            play_sound(task.sound)
            dbg(string.format("изъято: %s из %s (состояние %s)", art_section, container:section(), tostring(cond)))
        end
    end)
    if not ok then dbg("ОШИБКА отложенного действия: " .. tostring(err)) end
end

RegisterScriptCallback("update", apply_pending)

-- Перетаскивание: артефакт на контейнер (или наоборот). Только постановка задачи.
function on_item_dropped(first, second)
    local ok, err = pcall(function()
        if not db.actor or not first or not second then return end

        local container, artefact = second, first
        if is_container(first:section()) and is_artefact(second:section()) then
            container, artefact = first, second
        end

        if not is_container(container:section()) then return end
        if not is_artefact(artefact:section()) then return end
        if container:bq_has_artefact() then
            dbg("контейнер уже занят: " .. tostring(container:section()))
            return
        end

        pending = {
            mode         = "put",
            container_id = container:id(),
            artifact_id  = artefact:id(),
            artifact     = artefact:section(),
            condition    = get_condition(artefact),
            sound        = SOUND_BY_CONTAINER[container:section()],
        }
    end)
    if not ok then dbg("ОШИБКА обработчика перетаскивания: " .. tostring(err)) end
    return true
end

-- Действие "Достать артефакт" (use1_functor; движок показывает его только у
-- заполненного контейнера). Возвращаем false - предмет не расходуется.
function take_artifact(container)
    local ok, err = pcall(function()
        if not db.actor or not container then return end
        if not container:bq_has_artefact() then return end
        pending = {
            mode         = "take",
            container_id = container:id(),
            sound        = SOUND_TAKE_BY_CONTAINER[container:section()] or SOUND_BY_CONTAINER[container:section()],
        }
    end)
    if not ok then dbg("ОШИБКА обработчика изъятия: " .. tostring(err)) end
    return false
end

-- Заглушка: за callback OnItemFocusReceive отвечает конфиг аддона.
function on_item_focus(item)
end