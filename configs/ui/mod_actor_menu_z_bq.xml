<!--
    XMLOverride для ui\actor_menu.xml (4:3).
    Файл движок находит сам по маске mod_<имя файла>_*.xml рядом с оригиналом
    (AsureXML.cpp:203-224) и применяет атрибуты override:
      add     - дописать детей в найденный узел оригинала (AsureXML.cpp:186-197);
      replace - заменить найденный узел.

    ЧТО ДЕЛАЕМ: дописываем 14-й узел <slot> в конец inventory_slot_wnd - это
    слот CUSTOM_SLOT_1 (14), он же слот аккумулятора (slot = 13 в
    configs\misc\mod_batteries_z_bq.ltx). UI создаёт ячейки по порядку узлов
    <slot> (UIActorMenuInitialize.cpp:141-174), поэтому новый слот обязан быть
    ПОСЛЕДНИМ.

    ГЕОМЕТРИЯ (замерено по ванильному файлу; в ixray-hd-hud такие же числа):
      пояс:    dragdrop_belt x=360 y=480 width=300  -> занимает 360..660
      рюкзак:  dragdrop_bag  x=702 y=119
      значит между поясом и рюкзаком ровно 41 px - наша ячейка встаёт без
      наложений на реальные виджеты (перекрываются только полупрозрачные
      подсветки пояса, и только когда курсор на 5-й ячейке пояса).

    ПОДЛОЖКА СЛОТА: движок создаёт CUIProgressBar для каждого <slot>, у которого
    есть <slot_progress> (UIActorMenuInitialize.cpp:167-173), и подложка полосы
    (background) рисуется всегда. Поэтому <background> - наша полупрозрачная
    текстура слота, а <progress> указывает на ПОЛНОСТЬЮ прозрачную текстуру
    (ui_bq_battery_slot_prog), чтобы полоска не закрашивала слот.
    ВАЖНО: узел <progress> обязателен - без него CUIXmlInit::InitProgressBar
    выходит раньше разбора background (UIXmlInit.cpp:610-613).
    В пункте 4 (заряд) прозрачную текстуру заменим на настоящую полоску заряда.

    Текстуры: tools\gen_battery_slot.js -> textures\ui\ui_bq_battery_slot*.dds
-->
<w>
    <inventory_slot_wnd override="add">
        <slot> <!-- Аккумулятор (CUSTOM_SLOT_1 = 14) -->
            <slot_progress x="661" y="480" width="41" height="41" horz="1" min="0" max="1" pos="0">
                <background stretch="1">
                    <texture>ui\ui_bq_battery_slot</texture>
                </background>
                <progress stretch="1">
                    <texture>ui\ui_bq_battery_slot_prog</texture>
                </progress>
                <min_color r="196" g="18" b="18"/>
                <middle_color r="255" g="255" b="118"/>
                <max_color r="107" g="207" b="119"/>
            </slot_progress>
            <slot_highlight x="661" y="480" width="41" height="41" stretch="1">
                <texture>ui\ui_bq_battery_slot_hl</texture>
            </slot_highlight>
            <slot_dragdrop x="661" y="480" width="41" height="41"
                cell_width="41" cell_height="41" rows_num="1" cols_num="1"
                custom_placement="0" a="0" virtual_cells="1"
                vc_vert_align="c" vc_horiz_align="c"/>
        </slot>
    </inventory_slot_wnd>
</w>
