; Мод-оверрайд game_global.ltx.
; Движок для корневого файла X.ltx сам подгружает mod_X_*.ltx из той же
; папки (Xr_ini.cpp:1138), поэтому отдельный #include не нужен,
; а оригинал gamedata\configs\game_global.ltx не правится.
;
; Включаем Lua-колбэк перетаскивания предмета на предмет.
; В оригинале строка OnItemDropped закомментирована, из-за чего движок
; вообще не вызывает этот колбэк (LoadCallbackGlobals, xrGame.cpp:19).
;
; ВАЖНО: секцию обязательно помечать "!" (оверрайд). Без этого движок
; падает с "Duplicate section 'callbacks' wasn't marked as an override"
; (Xr_ini.cpp:1071).

; ВАЖНО: каждый ключ указывает ровно на ОДНУ функцию, поэтому точки входа
; распределены между механиками. Семантика возврата у ключей РАЗНАЯ:
;
;   OnItemDropped, OnItemFocusReceive - возврат игнорируется;
;   OnKeyPress         - true = "клавиша обработана" (не дойдёт до игры);
;   OnCanTake          - false = ЗАПРЕТИТЬ взять предмет из ящика;
;   OnCanMoveToPartner - false = ЗАПРЕТИТЬ торговлю;
;   OnZoneTouch        - возврат управляет звуком детектора зоны.
;
; Поэтому все наши функции возвращают безопасное значение своего ключа.
;
;   контейнеры: OnItemDropped (делает вложение) + OnItemFocusReceive
;               (переподписка и добивание отложенной задачи)
;   радиация:   OnKeyPress + OnCanMoveToPartner (переподписка и расчёт;
;               обращение к функции заставляет движок загрузить скрипт,
;               см. MEMO 33.7)
![callbacks]
OnItemDropped = bq_containers.on_item_dropped
OnItemFocusReceive = bq_containers.on_item_focus
OnKeyPress = bq_inv_rad.on_key_press
OnCanMoveToPartner = bq_inv_rad.on_can_move_to_partner
; Аккумулятор (пункт 2 плана): резервные точки загрузки bq_battery.script.
; Основная точка входа - start_game_callback в [alife] (см. mod_system_z_bq.ltx):
; движок зовёт её сам при старте игры и загрузке сейва. Эти три ключа нужны на
; случай перехода на другую локацию: объект-турер механики при переходе
; уничтожается движком, а тут механика снова попросит его создать (см. MEMO 33.7).
;
; Семантика возврата (все три требуют true, иначе сломается поведение игры):
;   OnItemFocusLost - результат игнорируется (UIActorMenu_action.cpp:371-383);
;   OnZoneTouch     - false ГЛУШИТ звук детектора зоны (UIHudStatesWnd.cpp:641-646);
;   OnBeforeHit     - false ОТМЕНЯЕТ попадание по актору (Actor.cpp:769-772).
; Поэтому одна функция on_load_trigger(...) возвращает true и ничего не читает.
OnItemFocusLost = bq_belt_hud.touch
OnZoneTouch = bq_battery.on_load_trigger
OnBeforeHit = bq_battery.on_load_trigger
