; ---------------------------------------------------------------------------
; Слот под аккумулятор (пункт 2 плана).
;
; Движок считает last_slot циклом до ПЕРВОГО ПРОПУСКА пары
; slot_persistent_N / slot_active_N (Inventory.cpp:66-78), а UI строит ячейки
; по числу узлов <slot> в actor_menu.xml (UIActorMenuInitialize.cpp:141-174).
; В ванильных файлах (и в ixray-hd-hud) ровно 13 узлов <slot>, поэтому наша
; ячейка - 14-я = CUSTOM_SLOT_1 = 14 (inventory_space.h:23-33).
;
; Значения:
;   13 - слот рюкзака. Ключей для него в ванильном system.ltx нет, поэтому
;        пишем их явно, повторяя поведение по умолчанию (CInventorySlot:
;        persistent = false, active = true). Без 13 движок остановит цикл и
;        до 14 не дойдёт.
;   14 - наш слот. persistent = FALSE обязателен: иначе движок не покажет
;        пункт «надеть» в контекстном меню (UIActorMenuInventory.cpp:1011).
;        active = false: слот не должен «активироваться» как оружие
;        (Inventory.cpp:578).
; ---------------------------------------------------------------------------
![inventory]
slot_persistent_13          = false
slot_active_13              = true
slot_persistent_14          = false
slot_active_14              = false

; ---------------------------------------------------------------------------
; Точка входа механики аккумулятора (пункт 2 плана).
;
; alife_section = "alife" (alife_simulator.cpp:25), и движок САМ вызывает
; функцию из этого ключа при старте новой игры и при загрузке сохранения
; (alife_simulator.cpp:81-84). Другого способа загрузить скрипт аддона в момент
; старта в сборке нет: scripts\*.script исполняются только при обращении по
; имени (MEMO 33.7).
;
; ВАЖНО: наша функция обязана сначала вызвать ванильный
; _G.start_game_callback (он определён в _g.script:514 и делает ванильную
; инициализацию), иначе игра останется без неё.
; ---------------------------------------------------------------------------
![alife]
start_game_callback         = bq_battery.on_game_start

#include "creatures\bq_spawn_sections_zaton.ltx"

; Наши секции артефактов и контейнеров (bq_container_base, bq_*_container,
; комбо-предметы). Подключать именно так, а НЕ через mod_artefacts_*.ltx:
; автоподхват "mod_<имя>_*.ltx" работает только когда движок открывает файл
; как КОРНЕВОЙ (Xr_ini.cpp:1138, ветка bIsRootFile), а misc\artefacts.ltx
; корневым не открывается - он включён через #include в system.ltx:16.
; Поэтому mod_artefacts_z_bq.ltx движок не находил и наши секции не грузились.
#include "misc\mod_artefacts_z_bq.ltx"

; Аккумуляторы для пояса артефактов (пункт 1 плана). Отдельный файл, потому что
; в пункте 5 вариаций станет больше; подключается #include по той же причине,
; что и артефакты - см. комментарий выше.
#include "misc\mod_batteries_z_bq.ltx"

