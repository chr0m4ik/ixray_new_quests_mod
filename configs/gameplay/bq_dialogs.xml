<?xml version="1.0" encoding="UTF-8"?>
<game_dialogs>
    <dialog id="bq_beard_start" priority="20">
        <has_info>zat_b14_give_item_linker</has_info>
        <dont_has_info>bq_quest_started</dont_has_info>
        <phrase_list>
            <phrase id="0">
                <text>bq_dlg_ask</text>
                <next>1</next>
            </phrase>
            <phrase id="1">
                <text>bq_dlg_offer</text>
                <next>11</next>
            </phrase>
            <phrase id="11">
                <text>bq_dlg_agree</text>
                <action>bq_quest.give_task</action>
            </phrase>
        </phrase_list>
        <precondition>bq_quest.can_start</precondition>
    </dialog>
    <dialog id="bq_beard_deliver">
        <precondition>bq_quest.has_documents</precondition>
        <has_info>bq_documents_taken</has_info>
        <dont_has_info>bq_docs_delivered</dont_has_info>
        <dont_has_info>bq_docs_sold</dont_has_info>
        <phrase_list>
            <phrase id="0">
                <text>bq_dlg_deliver_start</text>
                <next>1</next>
            </phrase>
            <phrase id="1">
                <text>bq_dlg_deliver_confirm</text>
                <action>bq_quest.on_documents_delivered</action>
            </phrase>
        </phrase_list>
    </dialog>
    <dialog id="bq_guide_hint">
        <has_info>bq_documents_taken</has_info>
        <dont_has_info>bq_docs_delivered</dont_has_info>
        <dont_has_info>bq_docs_sold</dont_has_info>
        <dont_has_info>bq_sich_hint_given</dont_has_info>
        <phrase_list>
            <phrase id="0">
                <text>bq_dlg_guide_ask</text>
                <next>1</next>
            </phrase>
            <phrase id="1">
                <text>bq_dlg_guide_answer</text>
                <action>bq_quest.on_sich_hint_given</action>
                <give_info>bq_sich_hint_given</give_info>
                <next>11</next>
            </phrase>
            <phrase id="11">
                <text>bq_dlg_guide_agree</text>
            </phrase>
        </phrase_list>
    </dialog>
    <dialog id="bq_sich_buy_docs">
        <precondition>bq_quest.has_documents</precondition>
        <has_info>bq_documents_taken</has_info>
        <dont_has_info>bq_docs_delivered</dont_has_info>
        <dont_has_info>bq_docs_sold</dont_has_info>
        <phrase_list>
            <phrase id="0">
                <text>bq_dlg_sich_start</text>
                <next>1</next>
            </phrase>
            <phrase id="1">
                <text>bq_dlg_sich_choose</text>
                <next>11</next>
                <next>12</next>
            </phrase>
            <phrase id="11">
                <text>bq_dlg_sich_sell</text>
                <action>bq_quest.on_documents_sold</action>
            </phrase>
            <phrase id="12">
                <text>bq_dlg_sich_not_sell</text>
            </phrase>
        </phrase_list>
    </dialog>
    <dialog id="bq_zaton_stalker_hmury_start">
        <has_info>bq_documents_taken</has_info>
        <dont_has_info>bq_docs_given_to_hmury</dont_has_info>
        <dont_has_info>bq_docs_delivered</dont_has_info>
        <dont_has_info>bq_docs_sold</dont_has_info>
        <phrase_list>
            <phrase id="0">
                <text>bq_hmury_dlg_offer_1</text>
                <next>1</next>
                <next>2</next>
                <next>3</next>
            </phrase>
            <phrase id="1">
                <text>bq_hmury_dlg_agree_1</text>
                <action>bq_hmury.give_docs_2000</action>
                <action>dialogs.break_dialog</action>
                <is_final>1</is_final>
            </phrase>
            <phrase id="2">
                <text>bq_hmury_dlg_bargain_1</text>
                <next>4</next>
            </phrase>
            <phrase id="3">
                <text>bq_hmury_dlg_attack_1</text>
                <action>bq_hmury.set_enemy_all</action>
                <action>dialogs.break_dialog</action>
                <is_final>1</is_final>
            </phrase>
            <phrase id="4">
                <text>bq_hmury_dlg_offer_2</text>
                <next>5</next>
                <next>6</next>
                <next>7</next>
            </phrase>
            <phrase id="5">
                <text>bq_hmury_dlg_agree_2</text>
                <action>bq_hmury.give_docs_2000_armor</action>
                <action>dialogs.break_dialog</action>
                <is_final>1</is_final>
            </phrase>
            <phrase id="6">
                <text>bq_hmury_dlg_attack_2</text>
                <action>bq_hmury.set_enemy_all</action>
                <action>dialogs.break_dialog</action>
                <is_final>1</is_final>
            </phrase>
            <phrase id="7">
                <text>bq_hmury_dlg_bargain_2</text>
                <next>71</next>
            </phrase>
            <phrase id="71">
                <text>bq_hmury_dlg_bargain_2_answer</text>
                <action>bq_hmury.set_enemy_all</action>
                <action>dialogs.break_dialog</action>
                <is_final>1</is_final>
            </phrase>
        </phrase_list>
        <precondition>bq_quest.has_documents</precondition>
        <dont_has_info>bq_hmury_hostile</dont_has_info>
    </dialog>


