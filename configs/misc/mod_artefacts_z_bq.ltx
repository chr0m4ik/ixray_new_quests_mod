visual                      = dynamics\equipments\aa\aac.ogf
; Свой атлас контейнеров: textures\ui\ui_bq_field_container.dds,
; 256x128, DXT5, ячейки 50x50 без отступов. Верхний ряд - пустые контейнеры
; (0,0) полевой, (1,0) универсальный, (2,0) научный; нижний ряд - те же
; контейнеры с артефактом внутри (пока не используются, см. пункт 5 плана).
icons_texture               = ui\ui_bq_field_container
radiation_restore_speed     = -0.004
hit_absorbation_sect        = bq_field_container_absorbation
; Пустой контейнер сам по себе НЕ даёт ничего, кроме поглощения радиации,
; и на пояс его надевать нельзя. Эти ключи заданы здесь, а не в шаблоне,
; потому что шаблон идёт последним родителем комбо и перебил бы статы
; артефакта (см. комментарий в bq_container_base).
belt                        = false
additional_inventory_weight = 0
health_restore_speed        = 0
satiety_restore_speed       = 0
power_restore_speed         = 0
bleeding_restore_speed      = 0
inv_grid_width              = 1
inv_grid_height             = 1
inv_grid_x                  = 0
inv_grid_y                  = 0

