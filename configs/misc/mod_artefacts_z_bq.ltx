inv_grid_width              = 1
inv_grid_height             = 1
inv_grid_x                  = 0
inv_grid_y                  = 1
radiation_restore_speed     = 0.002
use1_text                   = bq_take_artifact
use1_functor                = bq_containers.take_artifact

