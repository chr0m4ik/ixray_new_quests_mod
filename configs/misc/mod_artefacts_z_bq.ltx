burn_immunity               = 0
strike_immunity             = 0
shock_immunity              = 0
wound_immunity              = 0
radiation_immunity          = 0
telepatic_immunity          = 0
chemical_burn_immunity      = 0
explosion_immunity          = 0
fire_wound_immunity         = 0

; ---------------------------------------------------------------------------
; PROTOTYPE: combos for one artefact only - af_eye (Eye).
;
; RADIATION RULE (verified by the customer in game, see MEMO 13.2):
;     combo radiation = artefact radiation + min(container absorption, artefact radiation)
; The container absorbs NO MORE than the artefact emits, so the result can only
; be the artefact's own radiation or zero - never a negative value.
; For af_eye (vanilla radiation 0.002 = +2 in UI):
;     field  +2 + min(-4, +2) = 0
;     uni    +2 + min(-8, +2) = 0
;     sci    +2 + min(-14, +2) = 0
; Earlier the values here were computed as "artefact - absorption" without that
; clamp, which produced a wrong -6 for the universal container.
;
; Other stats are NOT touched: protection (hit_absorbation_sect + immunity
; table) and the restore speeds come from af_eye. The Eye has an all-zero
; immunity table, but it does have bleeding_restore_speed = 0.004 - that is its
; "slows bleeding" effect, and the combos inherit it.
; ---------------------------------------------------------------------------
[af_eye_bq_field_container]:af_eye, bq_container_base
