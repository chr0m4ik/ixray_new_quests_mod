; ============================================================================
; Artefact containers - sections for configs\misc\artefacts.ltx
;
; HOW THIS FILE IS LOADED (checked against the engine sources):
;   It is attached with "#include "misc\mod_artefacts_z_bq.ltx"" from
;   configs\mod_system_z_bq.ltx. The name keeps the mod_ prefix only by habit;
;   auto-discovery does NOT work here. The engine auto-loads
;   "mod_<rootfile>_*.ltx" only where it OPENS a file as the root one
;   (Xr_ini.cpp:1138, inside the bIsRootFile branch). misc\artefacts.ltx is
;   never opened as a root file - it is #include'd by configs\system.ltx:16 -
;   so a mod_artefacts_*.ltx is never found. That is why the sections are
;   pulled in explicitly instead.
;
; WHY NO FULL COPY OF artefacts.ltx: the root file system.ltx includes both
;   defines.ltx and misc\artefacts.ltx, so all their sections live in the same
;   CInifile and parents resolve across files (Xr_ini.cpp:271-283). Duplicate
;   checks happen inside a single file only (Xr_ini.cpp:1067-1077), so adding
;   our own sections is safe and does not require copying the vanilla file.
;
; Sections:
;   bq_container_base            - common part of an empty container
;   bq_field_container           - field container, absorbs 4 radiation
;   bq_uni_container             - universal container, absorbs 8
;   bq_sci_container             - scientific container, absorbs 14
;   <artefact>_<container>       - combo item (artefact inside a container)
;
; Combo section template: [<artefact>_bq_field_container]:<artefact>, bq_container_base
;   First parent  - the artefact: brings protection (hit_absorbation_sect) and
;                   all its stats.
;   Second parent - our container: brings the class, the visual and the icon
;                   atlas. It must be listed LAST because in a multiple
;                   inheritance the last parent wins (CInifile::EvaluateSection).
;
; CRITICAL: a combo MUST set inv_grid_x / inv_grid_y / icons_texture itself.
;   CInventoryItem::Load reads inv_grid_x/y from the section of the object
;   itself (inventory_item.cpp:190-193). If a combo inherited them from the
;   artefact (af_eye = 12,4) the icon was cut from the wrong atlas place and
;   was drawn as 2x2.
;
; PROVISIONAL ICONS: empty containers currently reuse the vanilla
;   ui\ui_icon_equipment atlas, so the combos use the same cells as their
;   container. A dedicated container atlas and the contents layer icon come in
;   a later step.
; ============================================================================

; ---------------------------------------------------------------------------
; Common part of an empty container. Every key that the engine reads strictly
; (Artefact.cpp:94-103, inventory_item.cpp:111-193) is listed here explicitly,
; because the vanilla af_base does NOT provide all of them.
; ---------------------------------------------------------------------------
[bq_container_base]:af_base
; class ОБЯЗАТЕЛЕН именно здесь: в оригинальном artefacts.ltx ключа class
; НЕТ ни у af_base, ни у identity_immunities (его задаёт каждый конкретный
; артефакт - af_eye, af_cristall и т.д.). Без этой строки пустые контейнеры
; оставались без класса, и движок падал:
;   CInifile::r_string: Can't find variable class in [bq_uni_container]
; Вылет происходил дважды: при перечислении секций в debug-спавнере
; (SpawnManager.cpp:137, pSettings->r_clsid) и при доставании артефакта,
; когда скрипт создавал пустой контейнер (alife():create).
class                       = ARTEFACT
; af_actor_properties - по НАЛИЧИЮ этого ключа движок решает, показывать ли окно
; характеристик артефакта: CUIArtefactParams::Check (ui_af_params.cpp:193-195)
; это ровно "line_exist(section, "af_actor_properties")", значение НЕ читается
; (ключ встречается в исходниках только в этой одной строке).
; В af_base он есть, здесь задаём явно.
;
; ВАЖНО, ПРОВЕРЕНО В ИГРЕ (08.10.2026): этот ключ НЕ управляет видимостью окна
; на практике. У СИМК он выставлен в "off" (см. bq_simk_container), но
; статистика ВСЁ РАВНО показывалась. Поэтому единственный рабочий способ убрать
; статы - ОБНУЛИТЬ их: SetInfo читает восстановление из секции предмета
; (ui_af_params.cpp:256) и иммунитеты из hit_absorbation_sect (:231-232), а
; строки с нулевыми значениями не добавляет (:233 и :257-260).
; "off" у СИМК оставлен как безвредный, но полагаться на него НЕЛЬЗЯ.
af_actor_properties         = on
actor_properties            = on
$spawn                      = "artefacts\bq_container"
inv_name                    = bq_container_name
inv_name_short              = bq_container_name
description                 = bq_container_descr
inv_weight                  = 2.0
; Цена ПОЛЕВОГО контейнера. Она задана здесь, в шаблоне, потому что
; bq_field_container своего cost не переопределяет - он наследует это значение.
; Универсальный и научный задают свои цены в собственных секциях.
cost                        = 20000
can_trade                   = true
af_rank                     = 0
lights_enabled              = false
; ВЫЛЕТ "Can't find particle bone [link]" - ИСПРАВЛЕНИЕ.
;
; Причина: ванильный af_base задаёт particles_bone = link, и комбо наследуют
; этот ключ от артефакта. CArtefact::Load (Artefact.cpp:64-91) устроен так:
;     if (line_exist(section, "particles_bones"))   // МНОЖЕСТВЕННОЕ число
;         ... LoadParticles(...)                    // кости берутся из секции
;     else if (line_exist(section, "particles_bone")) {   // единственное
;         m_sParticlesBone = r_string(...);         // здесь и приходит "link"
;         if (count > 1) ... else {
;             bone_id = K->LL_BoneID("link");
;             R_ASSERT2(bone_id != BI_NONE, "Can't find particle bone ...");
;         }
;     }
; Все наши модели контейнеров (aac/iam/aam и lead_box_open/closed) - статические
; меши БЕЗ костей (в файле нет блока BoneNames), поэтому кость не находится и
; игра падает при получении предмета.
;
; Поэтому задаём ключ particles_bones (МНОЖЕСТВЕННОЕ число): он уводит движок в
; первую ветку, и particles_bone = link из af_base уже НЕ ЧИТАЕТСЯ - ни проверки
; кости, ни вылета. Секции с таким именем нет, поэтому список костей пуст, а
; частиц у контейнеров и так нет: ключ particles не задан ни здесь, ни у комбо.
;
; Почему вылет не проявлялся раньше: у контейнеров стояла заглушка
; dynamics\artefacts\af_eye.ogf, а у модели артефакта Глаз кость link ЕСТЬ. То
; есть ошибка была заряжена и ждала настоящих моделей.
particles_bones             =
jump_height                 = 0
; inv_scale = 1.0 ОБЯЗАТЕЛЕН. Мод ixray-hq-icons-v2.0 переопределяет секции
; артефактов и задаёт им inv_scale = 2.0 (HD-атлас ui_icon_equipment_hd, там
; клетка 100 px). Комбо наследует от артефакта, поэтому без этой строки
; получало inv_scale = 2.0 и вырезало из нашего атласа область
; 50 * 2 = 100 пикселей, то есть 2x2 ячейки (проверено в игре). Наш атлас
; контейнеров - обычная сетка 50x50, ему нужен 1.0.
inv_scale                   = 1.0
; ВНИМАНИЕ: здесь НЕЛЬЗЯ задавать belt и *_restore_speed!
; В множественном наследовании X-Ray важнее ПОСЛЕДНИЙ родитель, а этот шаблон
; идёт вторым родителем комбо. Пока здесь стояли belt = false, все
; *_restore_speed = 0 и additional_inventory_weight = 0, они перебивали статы
; артефакта, и комбо теряло ВСЕ его эффекты: у Глаза пропадало замедление
; кровотечения (0.004), а на пояс комбо вообще не надевалось.
; Эти ключи теперь задают наследники: нули - пустые контейнеры, belt = true -
; комбо. af_base уже даёт belt = true, дополнительный вес = 0 и все
; *_restore_speed = 0.
; inv_grid_width/height = 0 скрывает ШАБЛОН из debug-спавнера: он считает
; секцию фиктивной, если оба ключа есть и оба <= 0
; (SpawnManager.cpp:160-161: isFakeItem => isInvItem = false).
inv_grid_width              = 0
inv_grid_height             = 0
; inv_grid_x/y ОБЯЗАТЕЛЬНЫ и на шаблоне: движок читает их строго, а не
; "если есть" (inventory_item.cpp:190, UICellCustomItems.cpp:539). Без них
; игра падала с "Can't find variable inv_grid_x in [bq_container_base]".
inv_grid_x                  = 0
inv_grid_y                  = 0

