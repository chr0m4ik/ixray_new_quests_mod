; ---------------------------------------------------------------------------
; PROTOTYPE: combos for one artefact only - af_eye (Eye).
; radiation_restore_speed = artefact radiation - container absorption,
; with the ORIGINAL af_eye values (radiation 0.002, bleeding 0.004):
;   field 0.002 - 0.004 = -0.002 -> clamped to 0 (container absorbs more
;                                    than the artefact emits);
;   uni   0.002 - 0.008 = -0.006;
;   sci   0.002 - 0.014 = -0.012.
; Protection is NOT rewritten here: hit_absorbation_sect and the immunity
; table come from af_eye (see the vanilla af_eye_absorbation).
; ---------------------------------------------------------------------------
[af_eye_bq_field_container]:af_eye, bq_container_base
description                 = bq_eye_field_descr
inv_name                    = bq_eye_field_name
inv_name_short              = bq_eye_field_name
belt                        = true
can_trade                   = false
icons_texture               = ui\ui_icon_equipment
inv_grid_x                  = 12
inv_grid_y                  = 4
radiation_restore_speed     = 0
use1_text                   = bq_take_artifact
use1_functor                = bq_containers.take_artifact

[af_eye_bq_uni_container]:af_eye, bq_container_base
