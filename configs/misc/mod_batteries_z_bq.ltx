; ============================================================================
; Аккумуляторы для пояса артефактов (пункты 1-2 плана).
;
; КАК ПОДКЛЮЧАЕТСЯ
;   Явным "#include "misc\mod_batteries_z_bq.ltx"" из configs\mod_system_z_bq.ltx.
;   Автоподхват "mod_<имя>_*.ltx" здесь не работает: движок ищет такие файлы
;   только рядом с КОРНЕВЫМ файлом (Xr_ini.cpp:1138), а misc\items.ltx
;   корневым не открывается - его включает system.ltx через #include.
;
; ЧТО ЭТО
;   Обычный предмет (class = II_ATTCH), как ванильные гитара, гармошка и
;   сканер B6. Лежит в СВОЁМ слоте (CUSTOM_SLOT_1 = 14) и "включает" пояс
;   артефактов. Проверяет слот и выключает пояс скрипт scripts\bq_battery.script,
;   состояние слота задано в configs\mod_system_z_bq.ltx (секция [inventory]),
;   ячейка в интерфейсе - XML-оверрайдами configs\ui\mod_actor_menu*_z_bq.xml.
;
; ПОЧЕМУ II_ATTCH
;   CLSID_IITEM_ATTACH = MK_CLSID('I','I','_','A','T','T','C','H')
;   зарегистрирован в игровой фабрике (object_factory_register.cpp:362).
;   Брать класс "по аналогии" нельзя: например, у ванильного [device_pda]
;   стоит class = S_PDA, а в игровой фабрике есть только D_PDA
;   (clsid_game.h:168) - при неизвестном CLSID движок печатает
;   "! [ERROR]: Invalid clsid!" и возвращает ЧУЖОЙ элемент фабрики
;   (object_factory_inline.h:55-68).
;
; ПРОЧНОСТЬ (заряд)
;   use_condition = true включает m_fCondition (0..1). У обычного предмета это
;   работает так же, как у оружия: значение сохраняется в сейве
;   (inventory_item.cpp:514, 825) и рисуется полоской в ячейке
;   (UICellItem.cpp:304-330) и в окне предмета (UIItemInfo.cpp:375).
;   Механика разряда - пункт 4.
;
; ЧТО ЛЕЖИТ В ФАЙЛЕ
;   [bq_battery_base] - общая часть: класс, слот, вес, цена, флаги, иконка;
;   [bq_battery_1]    - конкретные аккумуляторы (модель, имена, цена);
;   [bq_battery_2]
;
; ЗАГЛУШКИ ЭТОГО ЭТАПА (меняются в пунктах 5 и 6)
;   * иконка - ячейка атласа контейнеров (свой атлас будет в пункте 6);
;   * модели - свободные меши Anomaly, уже лежащие в аддоне
;     (выбрасывать аккумулятор можно, поэтому модель нужна);
;   * описания - временные ("хороший"/"средний").
; ============================================================================

; ---------------------------------------------------------------------------
; Общая часть аккумулятора.
; Родитель identity_immunities даёт строго читаемые ключи: immunities_sect,
; slot = -1, description, default_to_ruck, sprint_allowed,
; control_inertion_factor (defines.ltx:50-58, inventory_item.cpp:111-193).
; ---------------------------------------------------------------------------
[bq_battery_base]:identity_immunities
; class обязателен: без него движок падает при спавне и при перечислении
; секций в debug-спавнере (SpawnManager.cpp:137 -> pSettings->r_clsid).
class                       = II_ATTCH
$spawn                      = "devices\bq_battery"
GroupControlSection         = spawn_group
discovery_dependency        =
cform                       = skeleton

; ЗАГЛУШКА: своя модель будет в пункте 6. Меш обязан существовать, иначе
; движок молча не покажет секцию в спавнере (SpawnManager.cpp:139-156).
visual                      = dynamics\equipments\aa\cooler.ogf

; Маркер "это аккумулятор": по нему скрипт bq_battery.script понимает, что в
; слоте лежит именно аккумулятор (ключ читается строго после section_exist и
; line_exist - иначе Debug.fatal, MEMO 35.3).
bq_battery                  = true

inv_name                    = bq_battery_name
inv_name_short              = bq_battery_name
description                 = bq_battery_descr

inv_weight                  = 0.5
cost                        = 5000

; СВОЙ СЛОТ: slot = 13 -> base_slot_id = 14 = CUSTOM_SLOT_1
; (inventory_item.cpp:165-166). Слот разрешён только предметам с этим ключом,
; поэтому в него можно положить только аккумулятор. Состояние слота
; (slot_persistent_14 / slot_active_14) задано в configs\mod_system_z_bq.ltx,
; а ячейка в интерфейсе - в mod_actor_menu*_z_bq.xml.
; ВАЖНО: как только появился slot != -1, движок читает СТРОГО default_to_ruck,
; sprint_allowed и control_inertion_factor (inventory_item.cpp:182-187) - все
; три приходят из identity_immunities, ниже переопределён только первый.
slot                        = 13

; НЕ надевать автоматически при получении: default_to_ruck = true заставляет
; CInventory::Take положить предмет сразу в рюкзак (Inventory.cpp:188-206).
; Решение заказчика: аккумулятор дорогой, пусть игрок надевает его сам.
default_to_ruck             = true

; Продать нельзя, выбросить можно. quest_item убран намеренно: он запрещает и
; выброс, и перетаскивание (UIActorMenuInventory.cpp:1296,
; UIActorMenu_action.cpp:69), а нам нужны и то, и другое. Запрет продажи даёт
; can_trade = false: CanTrade() = FCanTrade && !IsQuestItem()
; (inventory_item.cpp:1524).
can_trade                   = false

; Заряд аккумулятора. Полоска состояния видна сразу, механика - пункт 4.
use_condition               = true

; Складывать несколько штук в одну ячейку можно только при равном заряде
; (решение заказчика, позже). Пока запрещено явно.
can_stack                   = false

; Аккумулятор носится в СВОЁМ слоте, а не на поясе артефактов.
belt                        = false

; ЗАГЛУШКА: иконка - ячейка атласа контейнеров (свой атлас будет в пункте 6).
; Атлас и сетка 50x50 проверены на контейнерах: DXT5, inv_scale = 1.0.
icons_texture               = ui\ui_bq_field_container

; inv_grid_width/height = 0 прячет ШАБЛОН из debug-спавнера: движок считает
; секцию фиктивной, если оба ключа есть и оба <= 0 (SpawnManager.cpp:160-161).
; У настоящих аккумуляторов ключи заданы явно.
inv_grid_width              = 0
inv_grid_height             = 0
inv_grid_x                  = 0
inv_grid_y                  = 0

; Позиция в руках - как у ванильных предметов класса II_ATTCH. Набор читается
; только целиком: если есть attach_angle_offset, то attach_position_offset и
; attach_bone_name читаются строго (attachable_item.cpp:51-64).
attach_angle_offset         = -1.571,-1.308,-1.458
attach_position_offset      = 0.105,-0.004,0.003
attach_bone_name            = bip01_l_hand
auto_attach                 = false

; ---------------------------------------------------------------------------
; Аккумулятор 1 - "хороший" (заглушка, характеристики в пункте 5).
; ---------------------------------------------------------------------------
[bq_battery_1]:bq_battery_base
visual                      = dynamics\equipments\aa\cooler.ogf
inv_name                    = bq_battery_1_name
inv_name_short              = bq_battery_1_name
description                 = bq_battery_1_descr
cost                        = 5000
inv_grid_width              = 1
inv_grid_height             = 1
inv_grid_x                  = 0
inv_grid_y                  = 0

; ---------------------------------------------------------------------------
; Аккумулятор 2 - "средний" (заглушка, характеристики в пункте 5).
; ---------------------------------------------------------------------------
[bq_battery_2]:bq_battery_base
visual                      = dynamics\equipments\aa\grid.ogf
inv_name                    = bq_battery_2_name
inv_name_short              = bq_battery_2_name
description                 = bq_battery_2_descr
cost                        = 8000
inv_grid_width              = 1
inv_grid_height             = 1
inv_grid_x                  = 1
inv_grid_y                  = 0
