; ============================================================================
; Combo items (artefact inside a container) - COMMON TEMPLATE + sections.
;
; Connected from configs\mod_system_z_bq.ltx:
;     #include "misc\artefacts_bq_containers.ltx"
;
; WHY THE TEMPLATE
;   A combo section used to repeat ~51 lines (all mandatory artefact keys).
;   Now the static part lives here once in [bq_combo_base], and every combo
;   inherits it, overriding only what differs (visual, names, icon, radiation).
;   Result: ~14 lines per combo instead of 51.
;
; CRITICAL RULES (see MEMO.md 15.3 / 15.6)
;  1. [bq_combo_base] MUST NOT contain inv_grid_x / inv_grid_y / inv_name.
;     CInventoryItem::Load reads inv_grid_x/y via m_object->cNameSect()
;     (inventory_item.cpp:190-193). If a combo inherited those keys from the
;     artefact (af_eye = 12,4), the icon was cut from the wrong atlas place
;     and showed up as 2x2.
;  2. A combo must NOT inherit from its artefact. Only from this template.
;  3. Every key read strictly (no READ_IF_EXISTS) must be present either here
;     or in the combo itself: immunities_sect, sprint_allowed,
;     control_inertion_factor, hud, animation_slot, particles_bone, attach_*,
;     slot, default_to_ruck, all *_restore_speed, inv_grid_*.
;
; EXPERIMENT STATUS
;   Only af_eye combos use the template so far. The other artefacts (cristall,
;   fireball, compass) still use flat sections in artefacts.ltx. If the eye
;   works (icon, stats, put/take), the rest will be converted the same way.
; ============================================================================

; ---------------------------------------------------------------------------
; Common part of every combo item. Contains NO inv_grid_* and NO inv_name
; on purpose - see rule 1 above.
; ---------------------------------------------------------------------------
[bq_combo_base]
$spawn                    = "artefacts\bq_combo"
class                     = ARTEFACT
inv_weight                = 2.0
cost                      = 12000
belt                      = true
can_trade                 = false
af_rank                   = 1
lights_enabled            = true
jump_height               = .05
particles                 = artefact\af_thermal_idle
det_show_particles        = artefact\af_thermal_show
det_hide_particles        = artefact\af_thermal_hide
trail_light_color         = 0.9,0.4,0.2
trail_light_range         = 2.0
af_actor_properties       = on
actor_properties          = on
can_be_controlled         = true
script_binding            = bind_artefact.bind
health_restore_speed      = 0
satiety_restore_speed     = 0
power_restore_speed       = 0
bleeding_restore_speed    = 0
additional_inventory_weight = 0
additional_inventory_weight2 = 0
hud                       = artefact_hud
animation_slot            = 11
particles_bone            = link
attach_angle_offset       = 0,0,0
attach_position_offset    = -0.1,-0.1,0
attach_bone_name          = bip01_root
slot                      = -1
default_to_ruck           = true
idle_light_shadow         = false
inv_grid_width            = 1
inv_grid_height           = 1
immunities_sect           = sect_identity_immunities
sprint_allowed            = true
control_inertion_factor   = 1.0

; ---------------------------------------------------------------------------
; af_eye - Eye. Cells: (0,1) field, (1,1) universal, (2,1) scientific.
; ---------------------------------------------------------------------------
[af_eye_field_container]:bq_combo_base
visual                    = dynamics\artefacts\af_eye.ogf
description               = eye_field_descr
inv_name                  = eye_field_name
inv_name_short            = eye_field_name
radiation_restore_speed   = 0
hit_absorbation_sect      = af_eye_field_container_absorbation
icons_texture             = ui\ui_bq_field_container
inv_grid_x                = 0
inv_grid_y                = 1
inv_grid_width            = 1
inv_grid_height           = 1
use1_text                 = bq_take_artifact
use1_functor              = bq_field_container.take_artifact

