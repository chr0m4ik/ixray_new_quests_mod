; ============================================================================
; Торговые данные для контейнеров (Сыч, zat_b30_owl_stalker_trader).
;
; ВАЖНО: файл читается СКРИПТОМ bq_container_trade.script во время игры, а не
; движком при загрузке конфигов. Поэтому он не конфликтует с другими аддонами.
;
; Почему не через configs\misc\trade\trade_zat_b30_stalker_trader.ltx:
; этот файл уже переопределён аддоном ixray-stcop-wp-3.7-cop-r1.0, и движок
; берёт его версию. Наш mod_*.ltx до него не доходит. Поэтому торговые таблицы
; и наличие товара задаются из скрипта через Lua-API:
;   npc:buy_condition(ini, section)   - цена, когда игрок покупает у торговца
;   npc:sell_condition(ini, section)  - цена, когда игрок продаёт торговцу
;   npc:buy_supplies(ini, section)    - наличие товара у торговца
;   npc:buy_item_condition_factor(f)  - минимальное состояние для скупки
;
; Формула цены (trade2.cpp): цена = cost * condition_factor * action_factor * discount
;   action_factor берётся из строки "x, y": x - при хорошем отношении,
;   y - при нейтральном/плохом. У нового предмета condition_factor = 1.
;
; Значения cost заданы в configs\misc\artefacts.ltx:
;   bq_field_container = 15000, bq_uni_container = 25000, bq_sci_container = 40000
;
; Комбо-предметы (артефакт внутри) в списках отсутствуют - купить или продать
; их нельзя.
; ============================================================================

; --- Цена, когда игрок покупает у Сыча (action_sell) ---
; cost * 1 = заданная цена
[bq_price_sell]
bq_field_container          = 1, 1
bq_uni_container            = 1, 1
bq_sci_container            = 1, 1

; --- Цена, когда игрок продаёт Сычу (action_buy) ---
; cost * 0.267: полевой 4000, универсальный 6675, научный 10680
[bq_price_buy]
bq_field_container          = 1, 0.267
bq_uni_container            = 1, 0.267
bq_sci_container            = 1, 0.267

; --- Наличие товара: секция = количество, вероятность появления (0..1) ---
[bq_supplies]
bq_field_container          = 2, 1.0
bq_uni_container            = 1, 0.2
bq_sci_container            = 1, 0.05

; --- Минимальное состояние предмета, которое торговец готов скупать ---
[bq_trade_params]
buy_item_condition_factor   = 0.7
