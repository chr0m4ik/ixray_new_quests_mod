; =================================================================================
; СПРАВКА ПО КЛАССУ АРТЕФАКТА (на примере af_eye)
; =================================================================================
; скорости увеличения (уменьшения) <- Заголовок блока скоростей изменения статов.

; health_restore_speed = 10 <- Восстановление здоровья.
; radiation_restore_speed = 10 <- Изменение радиации, в данном случае -10 (ед./сек).
; satiety_restore_speed = 10 <- Восстановление сытости (вроде не работает).
; power_restore_speed = 10 <- Восстановление выносливости (сил).
; bleeding_restore_speed = 10 <- Остановка кровотечения.
;
; additional_inventory_weight = 10 <- Прибавка к переносимому весу (кг).
; additional_inventory_weight2 = 0 <- Вторая прибавка к весу (в некоторых сборках для раздельного учёта; обычно 0).
;
; hit_absorbation_sect = af_eye_absorbation <- Ссылка на секцию с коэффициентами иммунитета.
;
; [af_eye_absorbation] <- Секция иммунитетов, применяемых к актору.
; burn_immunity = 10 <- Защита от термического урона.
; strike_immunity = 10 <- Защита от удара (падение, кулак, ударная волна).
; shock_immunity = 10 <- Защита от электричества.
; wound_immunity = 10 <- Защита от ранений (пулевые, осколочные).
; radiation_immunity = 10 <- Защита от радиации.
; telepatic_immunity = 10 <- Защита от пси-излучения.
; chemical_burn_immunity = 10 <- Защита от химки.
; explosion_immunity = 10 <- Защита от взрывов.
; fire_wound_immunity = 10 <- Защита от огнестрельных ранений (баллистика).
; =================================================================================

