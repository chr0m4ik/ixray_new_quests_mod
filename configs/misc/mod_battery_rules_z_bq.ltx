; ============================================================================
; ПРАВИЛА МЕХАНИКИ АККУМУЛЯТОРОВ (пункт 4-5 плана).
;
; Читает только scripts\bq_battery.script (движок эти секции не знает).
; Подключается явным "#include "misc\mod_battery_rules_z_bq.ltx"" из
; configs\mod_system_z_bq.ltx (автоподхват mod_<имя>_*.ltx работает только для
; КОРНЕВЫХ файлов, Xr_ini.cpp:1138, а misc\... корневым не открывается).
;
; Значения читаются строго в порядке section_exist -> line_exist -> r_* ,
; иначе движок падает в Debug.fatal (MEMO 35.3).
; ============================================================================

; ---------------------------------------------------------------------------
; РАЗРЯД
;   period_ms      - как часто скрипт пересчитывает заряд (мс реального времени);
;   mult_N         - множитель разряда при N артефактах НА ПОЯСЕ (считаются и
;                    наши комбо-контейнеры, они тоже class = ARTEFACT).
; Заказчик (10.10.2026): 0 и 1 артефакт - 0.6, дальше 1.0 / 1.5 / 2.0 / 2.5.
; Время берётся ИГРОВОЕ, поэтому сон и переходы тоже разряжают аккумулятор.
; ---------------------------------------------------------------------------
[bq_battery_discharge]
period_ms                   = 1000
mult_0                      = 0.6
mult_1                      = 0.6
mult_2                      = 1.0
mult_3                      = 1.5
mult_4                      = 2.0
mult_5                      = 2.5

; ---------------------------------------------------------------------------
; ОСЛАБЛЕНИЕ ПОЯСА ПО МЕРЕ РАЗРЯДА
;   Пояс отдаёт вклад артефактов не полностью, а пропорционально заряду:
;     множитель = weak_min_factor + (1 - weak_min_factor) * заряд
;   Заряд 100% -> 1.0 (всё как раньше), заряд около нуля -> weak_min_factor.
;   При weak_min_factor = 0.5 севший аккумулятор даёт половину силы пояса.
;   Технически мы масштабируем condition артефактов на поясе: движок умножает
;   на него и эффекты, и защиту, и вес (проверено в пункте 2). Побочный эффект:
;   в ячейке артефакта видно уменьшенную полоску состояния - это и есть индикатор
;   «пояс недокормлен». Ставим 1.0, если ослабление не нужно.
; ---------------------------------------------------------------------------
weak_min_factor             = 0.5

; Звук при полном разряде аккумулятора. Файл лежит в аддоне:
; sounds\device\bq_pda_alarm.ogg (взят из Anomaly, sounds\device\pda\pda_alarm.ogg).
; Путь задаётся относительно папки sounds и без расширения. Пусто = без звука.
alarm_sound                 = device\bq_pda_alarm

; ---------------------------------------------------------------------------
; ВЫПАДЕНИЕ ИЗ ТРУПОВ
;   chance_<секция>  - шанс, что у погибшего человека окажется этот аккумулятор;
;                      заказчик: батарейка 8%, аккумулятор 1.5%, тяжелый 0.5%
;                      (в сумме ~10%); самые мощные (научный и экспериментальный)
;                      не выпадают вообще.
;   condition_min/max - в каком состоянии он окажется (0..1, случайно).
;   radius            - на каком расстоянии от актора скрипт ищет гибнущих NPC
;                       (дальше игрок всё равно не обыщет труп);
;   period_ms         - как часто проверять смерти.
; Классы: сталкеры, бандиты, военные, наёмники, монолит. Зомби и мутанты - нет
; (список сообществ ниже, он сверяется со строкой сообщества NPC).
; ---------------------------------------------------------------------------
[bq_battery_drop]
period_ms                   = 1000
radius                      = 60
condition_min               = 0.0
condition_max               = 1.0
; Батарейка: 8% - стандарт (100% было временно для проверки выпадения).

chance_bq_battery_1         = 0.08
chance_bq_battery_2         = 0.015
chance_bq_battery_3         = 0.005
communities                 = stalker, bandit, army, killer, monolith

; ---------------------------------------------------------------------------
; ЗАРЯДКА У ТЕХНИКА (идея заказчика)
;   Цена зарядки ОДНОГО аккумулятора = его cost * factor, где factor берётся по
;   ТЕКУЩЕМУ заряду: находим наибольший порог, который не больше заряда в %.
;   Заказчик: полностью севший - дороже нового, до 15% - примерно как новый,
;   выше 15% - дешевле. Заряжаются СРАЗУ ВСЕ аккумуляторы игрока, наценки за
;   партию нет (об этом техник говорит в диалоге).
; ---------------------------------------------------------------------------
[bq_battery_recharge]
factor_0                    = 1.30
factor_15                   = 1.00
factor_40                   = 0.60
factor_70                   = 0.30
factor_95                   = 0.10
; ---------------------------------------------------------------------------
; ПАНЕЛЬ ПОЯСА НА HUD (scripts\bq_belt_hud.script)
;   hud_x / hud_y - положение первого значка в единицах интерфейса (база 1024x768).
;                   Слоты быстрого доступа стоят на x=16, 56, 96, 136 при y=705,
;                   поэтому панель начинается правее них - с x=190.
;   icon_gap      - зазор между значками.
; ---------------------------------------------------------------------------
[bq_battery_hud]
hud_x                       = 190
hud_y                       = 700
icon_gap                    = 4